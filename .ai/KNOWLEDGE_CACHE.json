  "rules": {
    "sdk3": [
      {"id": "R1", "title": "safeSetCapabilityValue", "severity": "critical", "description": "Always use safeSetCapabilityValue() in async callbacks. Checks _destroyed flag."},
      {"id": "R2", "title": "super.onDeleted() WiFi", "severity": "critical", "description": "WiFi devices MUST call await super.onDeleted() to prevent TCP leaks."},
      {"id": "R3", "title": "Mixin Order", "severity": "critical", "description": "PhysicalButtonMixin(VirtualButtonMixin(BaseClass)) - never reverse."},
      {"id": "R4", "title": "Buffer-Based JSON", "severity": "high", "description": "Use JSON.parse(fs.readFileSync(fpath)) without 'utf8' to avoid 2x memory."},
      {"id": "R5", "title": "_destroyed Guard", "severity": "high", "description": "Check this._destroyed at the start of all async callbacks."},
      {"id": "R6", "title": "No console.log in Drivers", "severity": "medium", "description": "Use this.log()/this.error()/this.warn() - never console.log/error."},
      {"id": "R7", "title": "UnifiedBatteryHandler", "severity": "high", "description": "Never use linear battery formulas. Always use UnifiedBatteryHandler.calculateFromVoltage()."},
      {"id": "R8", "title": "markAppCommand Before Physical", "severity": "high", "description": "Always call markAppCommand() before sending physical commands to prevent ghost presses."},
      {"id": "R9", "title": "No titleFormatted [[device]]", "severity": "medium", "description": "Never use titleFormatted with [[device]] in flow cards - causes manual device selection bug."},
      {"id": "R10", "title": "Backlight String Values", "severity": "medium", "description": "Backlight values must be strings: 'off', 'normal', 'inverted'. Never numeric."}
    ],
    "antiPatterns": [
      "Linear battery formulas - use UnifiedBatteryHandler",
      "Raw setCapabilityValue after destroy - use safeSetCapabilityValue",
      "console.log in drivers/ - use this.log()/this.error()",
      "UTF-16 JSON loading - use Buffer-based loading",
      "Overwriting constructor - use onInit()",
      "Blocking main thread in onInit - use async/await",
      "Missing super.onDeleted() in WiFi devices - leaks TCP",
      "Wildcard manufacturerName arrays - strictly forbidden",
      "Empty manufacturerName arrays - causes AggregateError",
      "capabilityMap recomputed on every _onData() - cache in onInit()"
    ],
    "mandatory": [
      "11-layer Zigbee pipeline must be respected",
      "Fingerprints: manufacturerName + productId combined match",
      "Settings keys: zb_model_id (not zb_modelId), zb_manufacturer_name",
      "Flow card IDs must be globally unique across ALL drivers",
      "Import paths from lib/tuya/ not lib/ directly",
      "CaseInsensitiveMatcher for all manufacturer name comparisons"
    ],
    "naming": [
      "Settings: zb_model_id, zb_manufacturer_name (snake_case with zb_ prefix)",
      "Flow IDs: {driver}_physical_gang{N}_{on|off}",
      "Driver dirs: drivers/{type}/ with device.js, driver.js, driver.compose.json",
      "Capabilities: 156 unique - check DynamicCapabilityManager before adding new"
    ],
    "security": [
      "Never commit tokens to .git/config",
      "Use GH_PAT secret for cross-repo access",
      "Block *.key, *.pem, config.json, secrets.json, credentials.json",
      "Never commit .env files",
      "GITHUB_TOKEN for current repo only"
