{
  "id": "device_cycle",
  "title": {
    "en": "Cycle device on/off",
    "fr": "Cycler l'appareil on/off",
    "nl": "Apparaat aan/uit cyclen",
    "de": "Gerät ein/aus zyklen"
  },
  "hint": {
    "en": "Repeats on/off cycles (like Tuya cycle timing for fans and irrigation), restoring the original state at the end",
    "fr": "Répète des cycles on/off (comme le cycle timing Tuya pour ventilateurs et irrigation), avec restauration de l'état initial à la fin"
  },
  "args": [
    {
      "name": "device",
      "type": "device",
      "filter": "capabilities=onoff"
    },
    {
      "name": "on_seconds",
      "type": "number",
      "title": {
        "en": "ON duration (seconds)",
        "fr": "Durée ON (secondes)"
      },
      "min": 1,
      "max": 3600,
      "step": 1,
      "value": 30
    },
    {
      "name": "off_seconds",
      "type": "number",
      "title": {
        "en": "OFF duration (seconds)",
        "fr": "Durée OFF (secondes)"
      },
      "min": 1,
      "max": 3600,
      "step": 1,
      "value": 30
    },
    {
      "name": "cycles",
      "type": "number",
      "title": {
        "en": "Cycles",
        "fr": "Cycles"
      },
      "min": 1,
      "max": 100,
      "step": 1,
      "value": 1
    }
  ],
  "titleFormatted": {
    "en": "Cycle [[device]] [[cycles]]× (ON [[on_seconds]]s / OFF [[off_seconds]]s)",
    "fr": "Cycler [[device]] [[cycles]]× (ON [[on_seconds]]s / OFF [[off_seconds]]s)"
  }
}
