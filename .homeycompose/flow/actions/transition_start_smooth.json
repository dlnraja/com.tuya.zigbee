{
  "id": "transition_start_smooth",
  "title": {
    "en": "Start smooth transition",
    "fr": "Démarrer une transition douce",
    "nl": "Vloeiende overgang starten",
    "de": "Sanften Übergang starten"
  },
  "hint": {
    "en": "Start a smooth transition on a numeric capability (e.g., dim, color_temperature)",
    "fr": "Démarrer une transition douce sur une capacité numérique (ex. dim, color_temperature)"
  },
  "args": [
    {
      "name": "device",
      "type": "device",
      "filter": "capabilities=onoff|dim"
    },
    {
      "name": "capability",
      "type": "text",
      "title": {
        "en": "Capability",
        "fr": "Capacité"
      },
      "placeholder": {
        "en": "dim"
      }
    },
    {
      "name": "from_value",
      "type": "number",
      "title": {
        "en": "From value",
        "fr": "Valeur de départ"
      },
      "min": -100000,
      "max": 100000,
      "placeholder": {
        "en": "-100000–100000",
        "fr": "-100000–100000"
      }
    },
    {
      "name": "to_value",
      "type": "number",
      "title": {
        "en": "To value",
        "fr": "Valeur d'arrivée"
      },
      "min": -100000,
      "max": 100000,
      "placeholder": {
        "en": "-100000–100000",
        "fr": "-100000–100000"
      }
    },
    {
      "name": "duration_seconds",
      "type": "number",
      "title": {
        "en": "Duration (seconds)",
        "fr": "Durée (secondes)"
      },
      "min": 0.5,
      "max": 3600,
      "step": 0.5,
      "value": 2,
      "placeholder": {
        "en": "0.5–3600",
        "fr": "0.5–3600"
      }
    },
    {
      "name": "easing",
      "type": "dropdown",
      "title": {
        "en": "Easing",
        "fr": "Courbe"
      },
      "values": [
        {
          "id": "linear",
          "title": {
            "en": "Linear"
          },
          "label": {
            "en": "Linear",
            "fr": "Linéaire"
          }
        },
        {
          "id": "easeIn",
          "title": {
            "en": "Ease In"
          },
          "label": {
            "en": "Ease In",
            "fr": "Accélération"
          }
        },
        {
          "id": "easeOut",
          "title": {
            "en": "Ease Out"
          },
          "label": {
            "en": "Ease Out",
            "fr": "Décélération"
          }
        },
        {
          "id": "easeInOut",
          "title": {
            "en": "Ease In-Out"
          },
          "label": {
            "en": "Ease In-Out",
            "fr": "Accélération-décélération"
          }
        },
        {
          "id": "cubicIn",
          "title": {
            "en": "Cubic In"
          },
          "label": {
            "en": "Cubic In",
            "fr": "Cubique entrée"
          }
        },
        {
          "id": "cubicOut",
          "title": {
            "en": "Cubic Out"
          },
          "label": {
            "en": "Cubic Out",
            "fr": "Cubique sortie"
          }
        },
        {
          "id": "cubicInOut",
          "title": {
            "en": "Cubic In-Out"
          },
          "label": {
            "en": "Cubic In-Out",
            "fr": "Cubique entrée-sortie"
          }
        }
      ]
    }
  ],
  "titleFormatted": {
    "en": "Start smooth transition [[capability]] [[from_value]] [[to_value]] [[duration_seconds]] [[easing]] ([[device]])",
    "fr": "Démarrer une transition douce [[capability]] [[from_value]] [[to_value]] [[duration_seconds]] [[easing]] ([[device]])",
    "nl": "Vloeiende overgang starten [[capability]] [[from_value]] [[to_value]] [[duration_seconds]] [[easing]] ([[device]])",
    "de": "Sanften Übergang starten [[capability]] [[from_value]] [[to_value]] [[duration_seconds]] [[easing]] ([[device]])"
  }
}
