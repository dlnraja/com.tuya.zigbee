          "id": "present",
          "title": {
            "en": "Present"
          },
          "label": {
            "en": "Present",
            "fr": "Présent"
          }
        },
        {
          "id": "clear",
          "title": {
            "en": "Clear"
          },
          "label": {
            "en": "Clear",
            "fr": "Libre"
          }
        }
      ]
    }
  ],
  "tokens": [
    {
      "name": "zone_name",
      "type": "string",
      "title": {
        "en": "Zone name",
        "fr": "Nom de la zone"
      }
    },
    {
      "name": "new_state",
      "type": "string",
      "title": {
        "en": "New state",
        "fr": "Nouvel état"
      }
    }
  ],
  "titleFormatted": {
    "en": "Force presence in zone [[force_state]]",
    "fr": "Forcer la présence dans la zone [[force_state]]"
