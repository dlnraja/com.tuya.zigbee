    {
      "type": "device",
      "name": "light_a",
      "filter": "capabilities=onoff",
      "title": { "en": "Welcome light A", "fr": "Lumière accueil A" }
    },
    {
      "type": "device",
      "name": "light_b",
      "filter": "capabilities=onoff",
      "title": { "en": "Welcome light B (optional)", "fr": "Lumière accueil B (option)" },
      "optional": true
    }
  ]
}
