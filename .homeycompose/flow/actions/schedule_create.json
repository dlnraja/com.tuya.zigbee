{
  "id": "schedule_create",
  "title": {
    "en": "Create schedule",
    "fr": "Créer un planning",
    "nl": "Schema aanmaken",
    "de": "Zeitplan erstellen"
  },
  "hint": {
    "en": "Create a new schedule for a device",
    "fr": "Créer une nouvelle planification pour un appareil"
  },
  "args": [
    {
      "name": "device",
      "type": "device",
      "filter": "capabilities=onoff|dim|target_temperature"
    },
    {
      "name": "schedule_name",
      "type": "text",
      "title": {
        "en": "Schedule name",
        "fr": "Nom de la planification"
      },
      "placeholder": {
        "en": "Schedule name",
        "fr": "Nom de la planification"
      }
    },
    {
      "name": "capability",
      "type": "text",
      "title": {
        "en": "Capability to set",
        "fr": "Capacité à régler"
      },
      "placeholder": {
        "en": "onoff"
      }
    },
    {
      "name": "capability_value",
      "type": "text",
      "title": {
        "en": "Value to set",
        "fr": "Valeur à régler"
      },
      "placeholder": {
        "en": "Value to set",
        "fr": "Valeur à régler"
      }
    },
    {
      "name": "cron_expression",
      "type": "text",
      "title": {
        "en": "Cron expression (min hour dom month dow)",
        "fr": "Expression cron (min heure jour mois jour-sem)"
      },
      "placeholder": {
        "en": "0 7 * * *"
      },
      "hint": {
        "en": "5-field cron: minute hour day-of-month month day-of-week. Example: '0 7 * * *' = daily at 7:00"
      }
    },
    {
      "name": "interval_minutes",
      "type": "number",
      "title": {
        "en": "Interval (minutes, 0 = use cron)",
        "fr": "Intervalle (minutes, 0 = cron)"
      },
      "min": 0,
      "max": 1440,
      "step": 5,
      "value": 0,
      "placeholder": {
        "en": "0–1440",
        "fr": "0–1440"
      }
    }
  ],
  "tokens": [
    {
      "name": "schedule_id",
      "type": "string",
      "title": {
        "en": "Created schedule ID",
        "fr": "ID de planification créée"
      }
    }
  ],
  "titleFormatted": {
    "en": "Create schedule [[schedule_name]] [[capability]] [[capability_value]] [[cron_expression]] [[interval_minutes]] ([[device]])",
    "fr": "Créer un planning [[schedule_name]] [[capability]] [[capability_value]] [[cron_expression]] [[interval_minutes]] ([[device]])",
    "nl": "Schema aanmaken [[schedule_name]] [[capability]] [[capability_value]] [[cron_expression]] [[interval_minutes]] ([[device]])",
    "de": "Zeitplan erstellen [[schedule_name]] [[capability]] [[capability_value]] [[cron_expression]] [[interval_minutes]] ([[device]])"
  }
}
