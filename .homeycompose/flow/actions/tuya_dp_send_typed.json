{
  "id": "tuya_dp_send_typed",
  "title": {
    "en": "Send typed Tuya DP",
    "fr": "Envoyer DP Tuya typé"
  },
  "hint": {
    "en": "Send a Tuya DP with explicit type (bool/value/enum/string/raw/bitmap)",
    "fr": "Envoie un DP Tuya avec type explicite"
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "capabilities=tuya_dp_value|onoff"
    },
    {
      "name": "dp",
      "type": "number",
      "title": {
        "en": "DP Number",
        "fr": "Numéro DP"
      },
      "min": 1,
      "max": 255,
      "placeholder": {
        "en": "1–255",
        "fr": "1–255"
      }
    },
    {
      "name": "dp_type",
      "type": "dropdown",
      "title": {
        "en": "DP Type",
        "fr": "Type DP"
      },
      "values": [
        {
          "id": "bool",
          "title": {
            "en": "Bool (true/false)"
          },
          "label": {
            "en": "Bool (true/false)",
            "fr": "Booléen (vrai/faux)"
          }
        },
        {
          "id": "value",
          "title": {
            "en": "Value (integer)"
          },
          "label": {
            "en": "Value (integer)",
            "fr": "Valeur (entier)"
          }
        },
        {
          "id": "enum",
          "title": {
            "en": "Enum (0-255)"
          },
          "label": {
            "en": "Enum (0-255)",
            "fr": "Énumération (0-255)"
          }
        },
        {
          "id": "string",
          "title": {
            "en": "String (text)"
          },
          "label": {
            "en": "String (text)",
            "fr": "Texte"
          }
        },
        {
          "id": "raw",
          "title": {
            "en": "Raw (hex bytes)"
          },
          "label": {
            "en": "Raw (hex bytes)",
            "fr": "Brut (octets hex)"
          }
        },
        {
          "id": "bitmap",
          "title": {
            "en": "Bitmap (bitmask)"
          },
          "label": {
            "en": "Bitmap (bitmask)",
            "fr": "Bitmap (masque)"
          }
        }
      ]
    },
    {
      "name": "value",
      "type": "text",
      "title": {
        "en": "Value",
        "fr": "Valeur"
      },
      "placeholder": {
        "en": "Value",
        "fr": "Valeur"
      }
    }
  ],
  "titleFormatted": {
    "en": "Send typed Tuya DP [[dp]] [[dp_type]] [[value]] ([[device]])",
    "fr": "Envoyer DP Tuya typé [[dp]] [[dp_type]] [[value]] ([[device]])"
  }
}
