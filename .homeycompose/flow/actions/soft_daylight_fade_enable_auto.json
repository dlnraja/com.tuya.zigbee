{
  "id": "soft_daylight_fade_enable_auto",
  "title": {
    "en": "Enable Soft Daylight Auto",
    "fr": "Activer Soft Daylight Auto",
    "nl": "Soft Daylight Auto inschakelen",
    "de": "Soft Daylight Auto aktivieren"
  },
  "hint": {
    "en": "Continuously follows Daylight Atmosphere with soft CCT/dim steps (full Adaptive-Lighting feel)",
    "fr": "Suit en continu Atmosphère jour avec fondu CCT/luminosité doux"
  },
  "args": [
    {
      "type": "device",
      "name": "light",
      "filter": "capabilities=onoff|capabilities=dim|capabilities=light_temperature|capabilities=light_color_temp",
      "title": {
        "en": "Light",
        "fr": "Lumière"
      }
    },
    {
      "type": "number",
      "name": "interval_minutes",
      "title": {
        "en": "Recheck every (min)",
        "fr": "Recalcul toutes (min)"
      },
      "min": 2,
      "max": 30,
      "step": 1,
      "value": 5,
      "placeholder": {
        "en": "2–30",
        "fr": "2–30"
      }
    }
  ],
  "titleFormatted": {
    "en": "Enable Soft Daylight Auto [[interval_minutes]] ([[light]])",
    "fr": "Activer Soft Daylight Auto [[interval_minutes]] ([[light]])",
    "nl": "Soft Daylight Auto inschakelen [[interval_minutes]] ([[light]])",
    "de": "Soft Daylight Auto aktivieren [[interval_minutes]] ([[light]])"
  }
}
