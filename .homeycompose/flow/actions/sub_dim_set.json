{
  "id": "sub_dim_set",
  "title": {
    "en": "Set sub-channel brightness",
    "fr": "Régler la luminosité d'une voie",
    "nl": "Helderheid van subkanaal instellen",
    "de": "Helligkeit eines Unterkanals setzen"
  },
  "hint": {
    "en": "Set a dim sub-capability (e.g. dim.channel2). Homey creates no cards for sub-capabilities.",
    "fr": "Règle une sous-capacité dim (ex : dim.channel2). Homey ne crée pas de cartes pour les sous-capacités."
  },
  "args": [
    { "type": "device", "name": "device", "filter": "capabilities=dim" },
    { "name": "capability", "type": "text", "title": { "en": "Capability", "fr": "Capacité" }, "placeholder": { "en": "dim.channel2", "fr": "dim.channel2" } },
    { "name": "value", "type": "range", "min": 0, "max": 1, "step": 0.01, "label": "%", "labelMultiplier": 100, "labelDecimals": 0, "title": { "en": "Brightness", "fr": "Luminosité" } }
  ],
  "titleFormatted": {
    "en": "Set [[capability]] to [[value]] ([[device]])",
    "fr": "Régler [[capability]] à [[value]] ([[device]])",
    "nl": "[[capability]] instellen op [[value]] ([[device]])",
    "de": "[[capability]] auf [[value]] setzen ([[device]])"
  }
}
