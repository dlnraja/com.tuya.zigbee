{
  "id": "hue_motion_lighting",
  "title": {
    "en": "Path Light (motion)",
    "fr": "Lumière de passage (mouvement)",
    "nl": "Padlicht (beweging)",
    "de": "Weglicht (Bewegung)"
  },
  "hint": {
    "en": "Turns a light on from motion, with optional lux gate and quiet hours; applies Daylight Atmosphere white",
    "fr": "Allume une lumière au mouvement, avec seuil lux et heures calmes optionnels ; blanc Atmosphère jour"
  },
  "args": [
    { "type": "device", "name": "motion_sensor", "title": { "en": "Motion sensor", "fr": "Capteur mouvement" } },
    { "type": "device", "name": "light", "title": { "en": "Light", "fr": "Lumière" } },
    { "type": "number", "name": "brightness", "title": { "en": "Brightness (%)", "fr": "Luminosité (%)" }, "min": 1, "max": 100, "placeholder": { "en": "80" } },
    { "type": "number", "name": "timeout", "title": { "en": "Timeout (min)", "fr": "Délai (min)" }, "min": 1, "max": 60, "placeholder": { "en": "5" } },
    { "type": "number", "name": "lux_threshold", "title": { "en": "Skip if lux ≥", "fr": "Ignorer si lux ≥" }, "min": 0, "max": 10000, "placeholder": { "en": "0" } },
    { "type": "text", "name": "quiet_start", "title": { "en": "Quiet start (HH:MM)", "fr": "Début calme (HH:MM)" }, "placeholder": { "en": "22:00" } },
    { "type": "text", "name": "quiet_end", "title": { "en": "Quiet end (HH:MM)", "fr": "Fin calme (HH:MM)" }, "placeholder": { "en": "07:00" } }
  ],
  "titleFormatted": {
    "en": "Path Light: [[motion_sensor]] → [[light]] at [[brightness]]% for [[timeout]] min (lux < [[lux_threshold]], quiet [[quiet_start]]-[[quiet_end]])",
    "fr": "Passage : [[motion_sensor]] → [[light]] à [[brightness]]% pour [[timeout]] min (lux < [[lux_threshold]], calme [[quiet_start]]-[[quiet_end]])"
  }
}
