{
  "id": "alt_zcl_attribute_write",
  "title": {
    "en": "Write Zigbee attribute",
    "fr": "Écrire un attribut Zigbee",
    "nl": "Zigbee-attribuut schrijven",
    "de": "Zigbee-Attribut schreiben"
  },
  "titleFormatted": {
    "en": "Write attribute [[attribute]] ([[data_type]]) = [[value]] in cluster [[cluster]] ep [[endpoint]] mfr [[manufacturer_code]] on [[device]]",
    "fr": "Écrire l'attribut [[attribute]] ([[data_type]]) = [[value]] du cluster [[cluster]] ep [[endpoint]] fab [[manufacturer_code]] sur [[device]]"
  },
  "hint": {
    "en": "Expert escape hatch: ZCL Write Attributes for settings the app does not expose yet. Zigbee devices only.",
    "fr": "Secours expert : écriture d'attribut ZCL pour un réglage pas encore exposé. Zigbee uniquement."
  },
