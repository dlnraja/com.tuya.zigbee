{
  "id": "presence_detected_in_zone",
  "title": {
    "en": "Presence detected in zone",
    "fr": "Présence détectée dans la zone"
  },
  "hint": {
    "en": "Triggers when the Virtual Presence Detector determines a zone is occupied",
    "fr": "Se déclenche quand le détecteur de présence virtuel juge qu'une zone est occupée"
  },
  "args": [
    {
      "name": "device",
      "type": "device",
      "filter": "driver_id=presence_detector"
    }
  ],
  "tokens": [
    {
      "name": "zone_name",
      "type": "string",
      "title": {
        "en": "Zone name",
        "fr": "Nom de la zone"
      },
      "example": "Living Room"
    },
    {
      "name": "confidence",
      "type": "number",
      "title": {
        "en": "Confidence (0-100)",
        "fr": "Confiance (0-100)"
      }
    },
    {
      "name": "monitored_devices",
      "type": "number",
      "title": {
        "en": "Number of signal sources",
        "fr": "Nombre de sources de signal"
      }
    },
    {
      "name": "duration_minutes",
      "type": "number",
      "title": {
        "en": "Duration (minutes)",
        "fr": "Durée (minutes)"
      }
    }
  ],
  "titleFormatted": {
    "en": "Presence detected in zone ([[device]])",
    "fr": "Présence détectée dans la zone ([[device]])"
  }
}
