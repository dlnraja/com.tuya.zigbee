{
  "id": "tuya_bitmap_changed",
  "title": {
    "en": "Tuya bitmap DP changed",
    "fr": "Bitmap Tuya changé",
    "nl": "Tuya-bitmap-DP gewijzigd",
    "de": "Tuya-Bitmap-DP geändert"
  },
  "hint": {
    "en": "Triggers when a bitmap (type 5) DP changes. Bitmap is a bitmask of active flags.",
    "fr": "Se déclenche quand un DP bitmap (type 5) change."
  },
  "tokens": [
    {
      "name": "dp_number",
      "type": "number",
      "title": {
        "en": "DP Number",
        "fr": "Numéro DP"
      },
      "example": 14
    },
    {
      "name": "bitmap",
      "type": "number",
      "title": {
        "en": "Bitmap value",
        "fr": "Valeur bitmap"
      },
      "example": 255
    }
  ],
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "capabilities=tuya_dp_bitmap"
    },
    {
      "name": "dp",
      "type": "number",
      "title": {
        "en": "DP Number (0=any)",
        "fr": "Numéro DP (0 = tous)"
      },
      "min": 0,
      "max": 255,
      "placeholder": {
        "en": "0–255",
        "fr": "0–255"
      }
    }
  ],
  "titleFormatted": {
    "en": "Tuya bitmap DP changed [[dp]] ([[device]])",
    "fr": "Bitmap Tuya changé [[dp]] ([[device]])"
  }
}
