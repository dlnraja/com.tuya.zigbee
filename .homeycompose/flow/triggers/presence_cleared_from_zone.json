{
  "id": "presence_cleared_from_zone",
  "title": {
    "en": "Presence cleared from zone",
    "fr": "Présence terminée dans la zone"
  },
  "hint": {
    "en": "Triggers when the Virtual Presence Detector determines a zone is no longer occupied",
    "fr": "Se déclenche quand le détecteur de présence virtuel juge qu'une zone n'est plus occupée"
  },
  "args": [
    {
      "name": "device",
      "type": "device",
      "filter": "driver_id=presence_detector"
    }
  ],
  "tokens": [
    {
      "name": "zone_name",
      "type": "string",
      "title": {
        "en": "Zone name",
        "fr": "Nom de la zone"
      },
      "example": "Living Room"
    },
    {
      "name": "was_present_minutes",
      "type": "number",
      "title": {
        "en": "Was present for (minutes)",
        "fr": "Présent pendant (minutes)"
      }
    },
    {
      "name": "final_confidence",
      "type": "number",
      "title": {
        "en": "Final confidence (0-100)",
        "fr": "Confiance finale (0-100)"
      }
    }
  ]
}
