{
  "id": "P2558-elegant-provenance-ux",
  "version": "1.1.0",
  "updated": "2026-09-17",
  "classify": "BOTH",
  "why": {
    "pourquoi": "Prioritize precise real measurements; label estimate/calc/predict elegantly in titles + flows",
    "comment": "DataProvenance priority + ≈/ƒ/→ marks; flow cards measured/estimated/calculated/predicted/not_measured",
    "pourQui": "Homey UI + Smart Flow builders (BOTH)",
    "quand": "every tracked capability write",
    "contreQuoi": "estimate looking like meter; estimate overwriting measured"
  },
  "origins": ["measured", "calculated", "estimated", "predicted"],
  "priority": { "measured": 100, "calculated": 70, "estimated": 40, "predicted": 20 },
  "ui": {
    "measured": "clean title (no mark)",
    "estimated": "· ≈ estimated / · ≈ estimé",
    "calculated": "· ƒ calculated / · ƒ calculé",
    "predicted": "· → predicted / · → prévu"
  },
  "flows": {
    "conditions": [
      "telemetry_is_measured",
      "telemetry_is_estimated",
      "telemetry_is_calculated",
      "telemetry_is_predicted",
      "telemetry_is_not_measured"
    ],
    "triggers": ["telemetry_source_changed"]
  },
  "gate": "npm run check:p2558"
}
