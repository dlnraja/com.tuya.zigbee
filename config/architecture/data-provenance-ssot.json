{
  "id": "P2560-smart-flow-local-learner",
  "version": "1.0.0",
  "updated": "2026-09-17",
  "classify": "BOTH",
  "why": {
    "pourquoi": "Elegant Smart Flow provenance cards + local habit/power learning (dim/color/on-time/EMA/bias) without cloud AI",
    "comment": "LocalSmartEnergyLearner + DeviceTelemetryEstimator wire; ≈/ƒ/→ flow titles + quality_label token",
    "pourQui": "Homey Flow builders + energy Insights (BOTH)",
    "quand": "every energy tick + measured power while ON + provenance change",
    "contreQuoi": "flat nominal-only estimates; soft data looking like live meters"
  },
  "origins": ["measured", "calculated", "estimated", "predicted"],
  "priority": { "measured": 100, "calculated": 70, "estimated": 40, "predicted": 20 },
  "ui": {
    "measured": "clean title (no mark)",
    "estimated": "· ≈ estimated / · ≈ estimé",
    "calculated": "· ƒ calculated / · ƒ calculé",
    "predicted": "· → predicted / · → prévu"
  },
  "flows": {
    "conditions": [
      "telemetry_is_measured",
      "telemetry_is_estimated",
      "telemetry_is_calculated",
      "telemetry_is_predicted",
      "telemetry_is_not_measured"
    ],
    "triggers": ["telemetry_source_changed"],
    "triggerTokens": ["capability", "previous", "origin", "quality_label"]
  },
  "learner": "LocalSmartEnergyLearner",
  "learnerInputs": [
    "usage_on_ms",
    "usage_off_ms",
    "dim",
    "light_mode",
    "measured_power_ema",
    "estimate_bias",
    "energy-consumption-reference",
    "nominal_power_settings"
  ],
  "related": ["P2556", "P2558", "P2560"],
  "gate": "npm run check:p2560"
}
