{
  "id": "intelligent-ir-ssot",
  "patch": "P2487",
  "dualApp": "MASTER_ONLY",
  "reliabilityBackport": "BOTH_for_zosung_tx_rx_only",
  "transports": ["zigbee_zosung", "wifi_tuya_local", "homey_infrared_tx"],
  "senderDrivers": ["ir_blaster", "blaster_remote", "wifi_ir_remote", "homey_infrared"],
  "virtualDriver": "ir_remote",
  "homeyInfrared": {
    "senderId": "homey_infrared",
    "permission": "homey:wireless:ir",
    "signal": "intelligent_ir_pronto",
    "signalCompose": ".homeycompose/signals/ir/intelligent_ir_pronto.json",
    "runtime": "lib/ir/HomeyInfraredTx.js",
    "txOnly": true,
    "format": "prontohex",
    "note": "Homey Pro 2023 onboard IR TX; learn stays Zigbee/WiFi; codes for Homey path stored on virtual ir_remote"
  },
  "clusters": {
    "zosungControl": "0xE004",
    "zosungTransmit": "0xED00"
  },
  "wifiDps": {
    "send": "201",
    "learnReceive": "202"
  },
  "formats": ["pronto", "broadlink", "globalcache", "hex", "zosung", "tuya_opaque"],
  "wizard": "assets/ir/ir_setup_wizard.html",
  "router": "lib/ir/IntelligentIRRouter.js",
  "converter": "lib/ir/IRFormatConverter.js",
  "floodGuard": {
    "patch": "P2501",
    "runtime": "lib/ir/IRFloodGuard.js",
    "wire": [
      "lib/ir/IntelligentIRRouter.js#send",
      "lib/ir/IntelligentIRRouter.js#learn",
      "lib/ir/HomeyInfraredTx.js#sendPronto",
      "drivers/ir_blaster/device.js#sendIRCode",
      "drivers/wifi_ir_remote/device.js#sendIRCode"
    ],
    "policy": {
      "identicalDedupMs": 900,
      "minIntervalMs": { "zigbee": 350, "wifi": 300, "homey": 400 },
      "maxRepetitions": 3,
      "globalMaxPerSecond": 5,
      "learnCooldownMs": 2500,
      "softSkip": ["identical_dedup", "sender_throttle"],
      "hardThrow": ["global_flood"]
    },
    "why": "Prevent Flow/UI spam flooding IR LED / Zosung chunk / Homey RF"
  },
  "outOfScope": [
    "homey_infrared_rx_learn",
    "global_cache_online_scrape",
    "ac_long_frame_synthesizer",
    "forum_post"
  ],
  "gate": "npm run check:p2487",
  "gateFlood": "npm run check:p2501",
  "tipMin": "9.0.922",
  "tipNote": "P2487 IR ≥9.0.922; P2501 flood guard ≥9.0.932+",
  "familyGate": "npm run check:p248x",
  "features": [
    "multi_transport_router",
    "format_normalize_pronto_broadlink_gc_hex_zosung",
    "wifi_flow_parity",
    "virtual_ir_remote_homey_zigbee_wifi",
    "wizard_sender_pick",
    "learned_rename_delete",
    "homey_pro_2023_pronto_tx_only",
    "p2501_ir_flood_guard"
  ]
}
