  "derivatives": [
    {
      "id": "zigbee-direct",
      "since": 2023,
      "kind": "extension",
      "notes": "Smartphone/BLE path to Zigbee network for commissioning/control; not Homey app DP logic"
    },
    {
      "id": "suzi",
      "since": 2025,
      "kind": "sub_ghz_extension",
      "brand": "Suzi",
      "bands": { "EU": "800 MHz", "NA": "900 MHz" },
      "certificationOpen": "2026-09-02",
      "replaces24ghz": false,
      "needsDualBandBridge": true,
      "notes": "Long-range Zigbee network-layer mesh on sub-GHz; complements 2.4 GHz; Homey Pro 2.4 GHz channel plan Contre quoi unchanged until dual-band hardware exists"
    },
    {
      "id": "green-power",
      "aka": ["ZGP", "ZGPD", "GreenPower"],
      "kind": "energy_harvesting_profile",
      "notes": "Batteryless kinetic switches (EnOcean PTM, Friends of Hue, some Tuya/Moes/Linptech K9Z as GreenPower_2). Needs Green Power Proxy/Sink on mains routers — not standard EF00/ZCL couple invent"
    },
    {
      "id": "matter",
      "kind": "interop_layer",
      "transports": ["Thread", "Wi-Fi", "Ethernet"],
      "notes": "CSA Matter ≠ Zigbee radio. Homey may bridge Zigbee→Matter at platform level; this app stays Tuya Zigbee ZCL/EF00"
    },
    {
      "id": "thread",
      "kind": "alternate_802_15_4_ip_mesh",
      "notes": "Same 2.4 GHz channel numbering family as Zigbee; not a Tuya EF00 drop-in"
    }
  ],
  "tuyaZigbeeStack": {
    "radioBaseline": "Zigbee 3.0-class modules on Homey (2.4 GHz)",
    "overlay": "Tuya private cluster 0xEF00 DP + hybrid ZCL",
    "manufacturerNamePrefixes": [
      {
        "prefix": "_TZ3000_",
        "typical": "ZCL-leaning switches/plugs/buttons (often TS000x/TS011F/TS004x)",
        "protocolHint": "zcl_or_hybrid"
      },
      {
        "prefix": "_TZ3210_",
        "typical": "ZCL/hybrid plugs and sensors",
        "protocolHint": "zcl_or_hybrid"
      },
      {
        "prefix": "_TZ3218_",
        "typical": "switch_temp_sensor and related",
        "protocolHint": "hybrid"
      },
      {
        "prefix": "_TZE200_",
        "typical": "MCU/DP devices (often TS0601)",
        "protocolHint": "ef00_mcu"
      },
      {
        "prefix": "_TZE204_",
        "typical": "MCU/DP sibling generation",
        "protocolHint": "ef00_mcu"
      },
      {
        "prefix": "_TZE284_",
        "typical": "Newer MCU/DP generation (dimmers, meters, valves, etc.)",
        "protocolHint": "ef00_mcu"
      },
      {
        "prefix": "_TZB210_",
        "typical": "LED/controller family (e.g. dimmable)",
        "protocolHint": "zcl_light"
      },
      {
        "prefix": "_TZE600_",
        "typical": "Less common MCU variants — couple-lock only",
        "protocolHint": "ef00_mcu"
      }
    ],
    "productIdFamilies": [
      { "pid": "TS0601", "notes": "Canonical Tuya MCU/DP productId — many OEM variants under different mfr" },
      { "pid": "TS0001", "notes": "1-gang ZCL switch class — mfr varies" },
      { "pid": "TS0002", "notes": "2-gang" },
      { "pid": "TS0003", "notes": "3-gang" },
      { "pid": "TS0004", "notes": "4-gang" },
      { "pid": "TS0041", "notes": "1-button wireless" },
      { "pid": "TS0044", "notes": "4-button / scene" },
      { "pid": "TS004F", "notes": "Knob / multi-button (scene vs command/dimmer — couple-aware)" },
      { "pid": "TS011F", "notes": "Plug / strip / energy" },
      { "pid": "TS0201", "notes": "Climate / sensor ZCL often" },
      { "pid": "TS0207", "notes": "Water leak or repeater — couple-aware" },
      { "pid": "TS0501B", "notes": "Dimmable LED/light" },
      { "pid": "TS0502B", "notes": "CCT / dim variants — do not Cartesian-invent onto wrong driver" }
    ],
    "mcuUartProtocol": {
      "frameHeader": "0x55AA",
      "dpTypes": { "0": "raw", "1": "bool", "2": "value", "3": "string", "4": "enum", "5": "bitmap" },
      "ef00Cluster": "0xEF00",
      "versions": [
        { "id": "v3.1", "timePayload": "8-byte dual UTC/local", "seqRequired": false },
        { "id": "v3.2", "timePayload": "8-byte", "seqRequired": false },
        { "id": "v3.3", "timePayload": "10-byte seq+UTC+local", "seqRequired": true },
        { "id": "v3.4", "timePayload": "10-byte + DP17 commit (e.g. weather)", "seqRequired": true },
        { "id": "v3.5", "timePayload": "10-byte extended TZ / date-string fallback", "seqRequired": true }
      ],
      "runtimeHelper": "lib/tuya/TuyaTimeSyncFormats.js",
      "moduleFirmwareVersionEncoding": "1-byte x.y.z packed (max 3.3.15) on Tuya UART product info"
    },
    "uartModuleSkus": [
      "mains-powered Zigbee module + MCU",
      "low-power Zigbee module + MCU",
      "scene-control Zigbee module variants",
      "three-tier concentrator (tertiary sub-devices) — rare Homey path"
    ]
  },
  "homeyAppImplications": [
    "Keep RF coexistence: Wi-Fi 1/6/11 ↔ Zigbee/Thread 15/20/25 @ 20 MHz",
    "Do not invent Suzi / Green Power productIds",
    "Never hardcode a single MCU time format",
    "Zigbee 4.0 / Suzi awareness ≠ new compose clusters without interview",
    "Tuya MCU query storms / aggressive power reporting can flood Homey Zigbee mesh — prefer BootBudget + soft reporting modes; never spam 0x10 version polls on sleepy (Z2M #28655)"
  ],
  "operationalRisks": [
    {
      "id": "tuya-tx-mesh-flood",
      "severity": "aggressive_reporting_and_mcu_polls",
      "homeyImpact": "High TX from EF00 dataQuery / configureReporting storms can starve sleepy end-devices and raise LQI drops on Homey Pro",
      "mitigations": [
        "BootBudget.shouldTxSleepy / markRadioActivity",
        "MCUVersionHelper: dataQuery-only — skip 0x10 version spam",
        "BaseUnifiedDevice power_report modes with minChange",
        "Prefer Zigbee 15/20/25 when Wi-Fi is 1/6/11 @ 20 MHz"
      ],
      "sources": [
        "community Homey Tuya TX flood reports",
        "Z2M #28655 mesh flood / pack drain"
      ]
    },
    {
      "id": "airbox-mispair-climate",
      "severity": "wrong_driver_class",
      "homeyImpact": "_TZE284_8b9zpaav / _TZE284_it9utkro + TS0601 are air quality (EF00 airbox) not climate_sensor",
      "mitigations": [
        "air_quality_co2 compose lock",
        "misattribution registry forbid climate_sensor"
      ],
      "sources": [
        "Z2M TS0601_airbox",
        "Z2M PM2.5_airbox",
        "ZHA #4971"
      ]
    }
  ],
  "enforcedImplications": {
