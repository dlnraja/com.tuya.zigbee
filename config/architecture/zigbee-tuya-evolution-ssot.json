      "formatsPath": "lib/tuya/TuyaTimeSyncFormats.js"
    },
    "composeInterviewGate": {
      "forbidAwarenessOnlyClusterTags": ["suzi", "sub_ghz", "subghz", "zigbee_direct_phy"],
