  "roles": {
    "switch": {
      "primaryUi": ["onoff", "onoff.gangN"],
      "buttonTiles": "maintenance",
      "maintenanceAction": true,
      "physicalSync": ["onoff", "pulse_optional"],
      "virtualPath": "VirtualButtonMixin._handleVirtualToggle",
      "homeyCharter": "Channel N labels; power state is the main tile"
    },
    "scene": {
      "primaryUi": ["button.N"],
      "buttonTiles": "device_view",
      "maintenanceAction": false,
      "physicalSync": ["pulse", "flows"],
      "virtualPath": "flow_only",
      "forbid": ["onoff", "dim"],
      "homeyCharter": "Button N visible in device UI; press feedback pulse"
    },
    "knob": {
      "primaryUi": ["dim", "button.N"],
      "buttonTiles": "device_view",
      "maintenanceAction": false,
      "physicalSync": ["dim", "pulse", "flows"],
      "virtualPath": "SmartKnobRotationMixin",
      "homeyCharter": "Brightness + rotate; scene-locked couples stay scene role"
    }
  },
  "titles": {
