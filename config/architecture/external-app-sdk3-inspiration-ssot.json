{
  "_meta": {
    "id": "external-app-sdk3-inspiration-ssot",
    "patch": "P2547",
    "updated": "2026-09-17",
    "dualApp": "BOTH",
    "why": "Mine sibling Homey Zigbee/Tuya GitHub apps + official SDK3 docs into durable refs/rules — complementary only, never invent pid, never forum POST."
  },
  "doctrine": {
    "complementaryOnly": true,
    "noInventPid": true,
    "noForumPost": true,
    "silentEnrich": true,
    "publishWhenAsked": true,
    "attribution": "Implement silently; changelogs stay generic (improved/added support) — no external-app name drops in Homey Community"
  },
  "officialSdk3": {
    "base": "https://apps.developer.homey.app",
    "preferMarkdown": true,
    "markdownHint": "Append .md to doc URLs for machine-readable pages",
    "pages": [
      {
        "id": "zigbee",
        "url": "https://apps.developer.homey.app/wireless/zigbee",
        "md": "https://apps.developer.homey.app/wireless/zigbee.md"
      },
      {
        "id": "capabilities",
        "url": "https://apps.developer.homey.app/the-basics/devices/capabilities",
        "md": "https://apps.developer.homey.app/the-basics/devices/capabilities.md"
      },
      {
        "id": "upgrade-zigbee",
        "url": "https://apps.developer.homey.app/upgrade-guides/upgrading-to-sdk-v3/upgrading-zigbee",
        "md": "https://apps.developer.homey.app/upgrade-guides/upgrading-to-sdk-v3/upgrading-zigbee.md"
      },
      {
        "id": "zigbeedriver-api",
        "url": "https://athombv.github.io/node-homey-zigbeedriver/ZigBeeDevice.html"
      }
    ],
    "rules": [
      {
        "id": "defer-zcl-on-init",
        "text": "Avoid initiating node communication in onInit/onNodeInit — defer + always catch promises",
        "runtime": ["lib/utils/Sdk3ZclSafe.js", "lib/performance/BootBudget.js", "lib/devices/UnifiedSensorBase.js"]
      },
      {
        "id": "catch-zcl-promises",
        "text": "Unhandled ZCL promises in onNodeInit can stall init (zigbeedriver <2.1.4 unavailable; >=2.1.4 may skip finish)",
        "runtime": ["lib/utils/Sdk3ZclSafe.js#catchZcl"]
      },
      {
        "id": "capability-catch",
        "text": "setCapabilityValue(...).catch(this.error) — prefer safeSetCapabilityValue (L14)",
        "runtime": ["lib/utils/Sdk3ZclSafe.js#setCapabilityCaught", "lib/tuya/TuyaZigbeeDevice.js"]
      },
      {
        "id": "identity-mfr-pid",
        "text": "Compose Zigbee identity = manufacturerName + productId only (drop deviceId/profileId)",
        "gates": ["npm run check:p2494", "npm run check:p2496"]
      },
      {
        "id": "onEndDeviceAnnounce",
        "text": "Sleepy wake path replaces node.on('online') — use onEndDeviceAnnounce for battery/bind heal",
        "runtime": ["lib/devices/UnifiedSensorBase.js", "lib/battery/BatteryMasterEngine.js"]
      },
      {
        "id": "isFirstInit",
        "text": "Heavy first-pair binds/reporting only inside isFirstInit() when possible",
        "runtime": ["lib/managers/IASZoneEnhanced.js"]
      },
      {
        "id": "flow-getDeviceTriggerCard",
        "text": "SDK3: getDeviceTriggerCard(id) one arg only — never (id,'trigger')",
        "gates": ["npm run check:p2449"]
      },
      {
        "id": "groups-pro2023",
        "text": "Homey Pro 2023–2026 listens group ID 0 + Touchlink getGroups only — do not assume all-group RX",
        "docs": ["docs/architecture/EXTERNAL_APP_SDK3_INSPIRATION_SSOT.md"]
      },
      {
        "id": "no-meshdriver",
        "text": "homey-meshdriver / onMeshInit / registerAttrReportListener are deprecated — use homey-zigbeedriver + configureAttributeReporting / boundCluster",
        "deps": ["homey-zigbeedriver@2.2.17", "zigbee-clusters"]
      },
      {
        "id": "p216-battery",
        "text": "Never blind ZCL batteryPercentageRemaining /2 — use normalizeZclBatteryPercent",
        "runtime": ["lib/battery/zcl-percent.js", "lib/utils/data-collector.js"]
      }
    ],
    "syncScript": ".github/scripts/sync-sdk3-docs.js",
    "referenceState": ".github/state/sdk3-reference.json"
  },
  "externalApps": [
    {
      "id": "johan-tuya-zigbee",
