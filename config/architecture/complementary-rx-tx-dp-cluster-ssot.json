{
  "id": "complementary-rx-tx-dp-cluster-ssot",
  "patch": "P2699",
  "dualApp": "BOTH",
  "updated": "2026-09-23",
  "doctrine": {
    "complementaryOnly": true,
    "noInventPid": true,
    "unionNotReplace": true,
    "ef00AndZclParallelOk": true,
    "rawIsLastResortNotOnly": true,
    "wrappersBeyondHomeyLibs": true,
    "nonNativeNeverMandatory": true
  },
  "nonNativeHomeyGaps": {
    "mode": "complementary_never_mandatory",
    "why": "Homey SDK/interview does not natively cover every Tuya DP / proprietary cluster — treat gaps as parallel soft paths, never compose/bind/boot requirements",
    "never": [
      "compose_require_proprietary_only",
      "hard_throw_missing_ef00_on_boot",
      "force_bind_non_interviewed_cluster",
      "invent_pid_to_cover_gap"
    ],
    "always": [
      "parallel_rx_tx_cascade",
      "raw_frame_parse",
      "raw_cluster_fallback",
      "protocol_fallback_chain",
      "soft_stub_missing_methods",
      "passive_listen_stream",
      "magic_handshake_soft"
    ],
    "clusterExamples": [
      "0xEF00",
      "0xE000",
      "0xE002",
      "0xED00",
      "0xFD",
      "0xFC",
      "msCO2",
      "vocMeasurement"
    ],
    "runtimeHelper": "lib/io/NonNativeComplementary.js",
    "gate": "npm run check:p2699"
  },
  "rxOrderCanonical": [
    "capability_listener",
    "zcl_attr_report",
    "tuya_dp_report",
    "tuya_bound_report",
    "ias_zone",
    "raw_frame_parse",
    "raw_cluster_fallback",
    "cluster_data_query",
    "mcu_report",
    "flow_trigger",
    "energy_report",
    "poll_heuristic",
    "antispam_filter"
  ],
  "txOrderCanonical": [
    "wrapper_manager",
    "sdk3_direct",
    "cluster_command",
    "tuya_bound_cluster",
    "cluster_bind",
    "capability_command_router",
    "quirk_guided",
    "raw_zcl_frame",
    "mcu_version_helper",
    "magic_handshake_retry",
    "flow_action",
    "ota_firmware",
    "poll_heuristic"
  ],
  "protocolPaths": [
    "tuya_dp",
    "zcl",
    "tuya_bound",
    "cluster_bound",
    "raw_frame",
    "raw_value",
    "mcu",
    "ias",
