  "airQualityComplementary": {
    "driver": "air_quality_co2",
    "ef00Primary": true,
    "zclAlternates": [
      { "clusterNames": ["msCO2", "carbonDioxideMeasurement", "msCarbonDioxide"], "capability": "measure_co2" },
      { "clusterNames": ["msTemperatureMeasurement", "temperatureMeasurement"], "capability": "measure_temperature" },
      { "clusterNames": ["msRelativeHumidity", "relativeHumidity"], "capability": "measure_humidity" },
      { "clusterNames": ["pm25Measurement", "msFineParticle"], "capability": "measure_pm25" },
      { "clusterNames": ["vocMeasurement", "msVOC", "msVoc"], "capability": "measure_voc" },
      { "clusterNames": ["formaldehydeMeasurement", "msFormaldehyde"], "capability": "measure_formaldehyde" }
    ],
    "rawFallbackMustListen": [
      "msCO2",
      "carbonDioxideMeasurement",
      "pm25Measurement",
      "formaldehydeMeasurement",
      "vocMeasurement"
    ],
    "notes": "Z2M airbox EF00 + ZHA ZCL sibling yvx5lh6k — HYBRID listen; LayerSignalFusion dedups"
  },
  "runtimeModules": {
    "ProtocolFallbackChain": "lib/io/ProtocolFallbackChain.js",
