{
  "name": {
    "en": "LED Controller Dimmable",
    "fr": "Contrôleur LED Dimmable",
    "de": "LED Controller Dimmbar",
    "nl": "LED Controller Dimbaar"
  },
  "class": "light",
  "capabilities": [
    "onoff",
    "dim",
    "button.1"
  ],
  "capabilitiesOptions": {
    "dim": {
      "min": 0.01,
      "step": 0.01
    },
    "button.1": {
      "title": {
        "en": "Button 1",
        "fr": "Bouton 1"
      },
      "maintenanceAction": true,
      "getable": false,
      "setable": false
    }
  },
  "zigbee": {
    "manufacturerName": [
      "_tzb210_3dxbg9ks",
      "_TZ3000_iystcadi",
      "_TZB210_3DXBG9KS",
      "_TZ3000_IYSTCADI",
      "_tz3000_iystcadi",
      "_TZB210_3dxbg9ks",
      "_tzb210_3DXBG9KS",
      "_tz3000_IYSTCADI",
      "_TZB210_rkgngb5o",
      "_tzb210_rkgngb5o",
      "_TZB210_RKGNGB5O",
      "_tzb210_RKGNGB5O",
      "_tz3210_f8dqbuze",
      "_TZ3210_f8dqbuze",
      "_TZ3210_F8DQBUZE",
      "_tz3210_F8DQBUZE",
      "_tz3210_zkhmztqn",
      "_TZ3210_zkhmztqn",
      "_TZ3210_ZKHMZTQN",
      "_tz3210_ZKHMZTQN"
    ],
    "productId": [
      "TS0601_led",
      "TS0501B",
      "TRI-C1ZR",
      "TRI-K1ZR"
    ],
    "endpoints": {
      "1": {
        "clusters": [
          0,
          3,
          4,
          5,
          6,
          8
        ]
      }
    },
    "subDevices": []
  },
  "images": {
    "small": "/drivers/led_controller_dimmable/assets/images/small.png",
    "large": "/drivers/led_controller_dimmable/assets/images/large.png"
  },
  "platforms": [
    "local"
  ],
  "connectivity": [
    "zigbee"
  ],
  "energy": {
    "approximation": {
      "usageOn": 60,
      "usageOff": 0.5
    }
  },
  "maintenanceActions": [
    {
      "id": "ota_check",
      "title": {
        "en": "Check Zigbee OTA Update",
        "fr": "Vérifier MàJ OTA",
        "nl": "Controleer op OTA-updates"
      }
    },
    {
      "id": "tuya_revive",
      "title": {
        "en": "Tuya Revive (device recovery)",
        "fr": "Tuya Revive (récupération appareil)",
        "nl": "Tuya Revive (apparaatherstel)",
        "de": "Tuya Revive (Gerätewiederherstellung)"
      }
    },
    {
      "id": "generate_issue_report",
      "title": {
        "en": "Generate support report (GitHub issue)",
        "fr": "Générer rapport de support (issue GitHub)",
        "nl": "Supportrapport genereren (GitHub issue)",
        "de": "Supportbericht erstellen (GitHub Issue)"
      }
    },
    {
      "id": "zigbee_rebind",
      "title": {
        "en": "Re-bind & reconfigure reporting",
        "fr": "Re-lier et reconfigurer les rapports",
        "nl": "Opnieuw binden en rapportage instellen",
        "de": "Neu binden und Reporting konfigurieren"
      }
    }
  ],
  "id": "led_controller_dimmable",
  "version": "1.0.0",
  "ui": {
    "quickAction": "onoff"
  },
  "settings": [
    {
      "$extends": [
        "zcl_cluster_layer"
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Adaptive lighting",
        "fr": "Éclairage adaptatif",
        "de": "Adaptive Beleuchtung",
        "nl": "Adaptieve verlichting"
      },
      "children": [
        {
          "id": "adaptive_lighting",
          "type": "checkbox",
          "value": true,
          "label": {
            "en": "Follow the sun (colour temperature)",
            "fr": "Suivre le soleil (température de couleur)",
            "de": "Dem Sonnenlauf folgen (Farbtemperatur)",
            "nl": "De zon volgen (kleurtemperatuur)"
          },
          "hint": {
            "en": "On by default. Nothing changes until the light is next switched on; a manual change pauses it for 60 min. Untick to disable for this light (global switch: app settings).",
            "fr": "Actif par défaut. Rien ne change avant le prochain allumage ; un réglage manuel le met en pause 60 min. Décochez pour désactiver sur cette lampe (interrupteur global : réglages de l'app).",
            "de": "Standardmäßig aktiv. Erst beim nächsten Einschalten wirksam; eine manuelle Änderung pausiert es 60 Min. Abwählen, um es für diese Lampe zu deaktivieren (globaler Schalter: App-Einstellungen).",
            "nl": "Standaard aan. Pas actief bij de volgende keer inschakelen; een handmatige wijziging pauzeert het 60 min. Uitvinken om het voor deze lamp uit te zetten (globale schakelaar: app-instellingen)."
          }
        },
        {
          "id": "adaptive_brightness",
          "type": "checkbox",
          "value": false,
          "label": {
            "en": "Also adapt brightness",
            "fr": "Adapter aussi la luminosité",
            "de": "Auch die Helligkeit anpassen",
            "nl": "Ook de helderheid aanpassen"
          },
          "hint": {
            "en": "Off by default. Dimmer-only lights only adapt when this is on.",
            "fr": "Désactivé par défaut. Les lampes sans température de couleur ne s'adaptent que si cette option est active.",
            "de": "Standardmäßig aus. Lampen ohne Farbtemperatur passen sich nur an, wenn dies aktiv ist.",
            "nl": "Standaard uit. Lampen zonder kleurtemperatuur passen zich alleen aan als dit aan staat."
          }
        }
      ]
    }
  ]
}
