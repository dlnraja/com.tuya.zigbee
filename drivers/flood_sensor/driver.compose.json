{
  "id": "floodsensor",
  "name": {
    "en": "Flood sensor",
    "fr": "Détecteur d'inondation",
    "de": "Wassersensor",
    "nl": "Overstromingssensor"
  },
  "class": "sensor",
  "platforms": [
    "local"
  ],
  "connectivity": [
    "zigbee"
  ],
  "capabilities": [
    "alarm_water",
    "measure_battery",
    "button.1"
  ],
  "energy": {
    "batteries": [
      "CR2032"
    ]
  },
  "images": {
    "small": "/drivers/flood_sensor/assets/images/small.png",
    "large": "/drivers/flood_sensor/assets/images/large.png"
  },
  "zigbee": {
    "productId": [
      "TS0207",
      "RH3001"
    ],
    "endpoints": {
      "1": {
        "clusters": [
          0,
          1,
          3,
          1280
        ],
        "bindings": [
          1,
          1280
        ]
      }
    },
    "learnmode": {
      "image": "{{driverAssetsPath}}/icon.svg",
      "instruction": {
        "en": "Push the button for aprox 10 seconds until the LED blinks rapidly. If nothing happens; put two fingers against the detectors and repeat.",
        "fr": "Appuyez env. 10 s sur le bouton jusqu'au clignotement rapide de la LED. Sinon, posez deux doigts sur les capteurs et recommencez."
      }
    },
    "manufacturerName": [
      "_hybrid_flood_sensor_needs_device_assignment",
      "_HYBRID_FLOOD_SENSOR_NEEDS_DEVICE_ASSIGNMENT"
    ]
  },
  "version": "1.0.0",
  "capabilitiesOptions": {
    "button.1": {
      "title": {
        "en": "Button 1",
        "fr": "Bouton 1"
      },
      "maintenanceAction": true,
      "getable": false,
      "setable": false
    },
    "alarm_water": {
      "getable": true,
      "preventInsights": false
    },
    "measure_battery": {
      "getable": true,
      "preventInsights": false
    }
  }
}
