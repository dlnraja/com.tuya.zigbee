{
  "name": {
    "en": "Led Strip Advanced",
    "fr": "Led Strip Advanced",
    "nl": "Geavanceerde LED Strip",
    "de": "Erweiterte LED Streifen"
  },
  "class": "light",
  "energy": {
    "approximation": {
      "usageOn": 15,
      "usageOff": 0.5
    }
  },
  "capabilities": [
    "dim",
    "light_hue",
    "light_saturation",
    "light_temperature",
    "light_mode",
    "onoff",
    "button.1"
  ],
  "zigbee": {
    "manufacturerName": [
      "_tz3000_oboryztc",
      "_TZ3000_OBORYZTC",
      "_TZ3000_oboryztc",
      "_tz3000_OBORYZTC"
    ],
    "endpoints": {
      "1": {
        "clusters": [
          0,
          3,
          4,
          5,
          6,
          8,
          768
        ]
      }
    },
    "learnmode": {
      "image": "{{driverAssetsPath}}/icon.svg",
      "instruction": {
        "en": "Press and hold the pairing button for 5 seconds until the LED flashes.",
        "fr": "Appuyez et maintenez le bouton d'appairage pendant 5 secondes jusqu'à ce que la LED clignote."
      }
    },
    "productId": [
      "TS0601_strip_adv"
    ]
  },
  "settings": [
    {
      "id": "power_source",
      "type": "dropdown",
      "label": {
        "en": "Power Source",
        "nl": "Voedingsbron",
        "de": "Stromquelle",
        "fr": "Source d'Alimentation"
      },
      "value": "auto",
      "values": [
        {
          "id": "auto",
          "label": {
            "en": "Auto Detect",
            "fr": "Détection Automatique"
          }
        },
        {
          "id": "ac",
          "label": {
            "en": "AC Powered",
            "fr": "Alimentation Secteur"
          }
        },
        {
          "id": "dc",
          "label": {
            "en": "DC Powered",
            "fr": "Alimentation DC"
          }
        },
        {
          "id": "battery",
          "label": {
            "en": "Battery Powered",
            "fr": "Sur Batterie"
          }
        }
      ],
      "hint": {
        "en": "Select power source manually or use auto-detection",
        "fr": "Sélectionnez la source d'alimentation manuellement ou utilisez la détection automatique"
      }
    },
    {
      "id": "battery_type",
      "type": "dropdown",
      "label": {
        "en": "Battery Type",
        "nl": "Batterijtype",
        "de": "Batterietyp",
        "fr": "Type de Batterie"
      },
      "value": "auto",
      "values": [
        {
          "id": "auto",
          "label": {
            "en": "Auto Detect",
            "fr": "Détection Automatique"
          }
        },
        {
          "id": "CR2032",
          "label": {
            "en": "CR2032",
            "fr": "CR2032 (Pile Bouton 3V)"
          }
        },
        {
          "id": "CR2450",
          "label": {
            "en": "CR2450",
            "fr": "CR2450 (Pile Bouton 3V)"
          }
        },
        {
          "id": "AAA",
          "label": {
            "en": "AAA",
            "fr": "AAA"
          }
        },
        {
          "id": "AA",
          "label": {
            "en": "AA",
            "fr": "AA"
          }
        },
        {
          "id": "CR123A",
          "label": {
            "en": "CR123A",
            "fr": "CR123A"
          }
        }
      ],
      "hint": {
        "en": "Select battery type manually or use auto-detection based on voltage",
        "fr": "Sélectionnez le type de batterie manuellement ou utilisez la détection automatique basée sur la tension"
      }
    },
    {
      "id": "battery_low_threshold",
      "type": "number",
      "label": {
        "en": "Low Battery Threshold",
        "nl": "Drempel voor lage batterij",
        "de": "Schwellenwert für niedrigen Akkustand",
        "fr": "Seuil Batterie Faible (%)"
      },
      "value": 20,
      "min": 0,
      "max": 50,
      "step": 5,
      "hint": {
        "en": "Trigger low battery warning when below this percentage",
        "fr": "Déclencher l'alerte batterie faible en dessous de ce pourcentage"
      }
    },
    {
      "id": "battery_critical_threshold",
      "type": "number",
      "label": {
        "en": "Critical Battery Threshold",
        "nl": "Drempel voor kritieke batterij",
        "de": "Schwellenwert für kritischen Akkustand",
        "fr": "Seuil Batterie Critique (%)"
      },
      "value": 10,
      "min": 0,
      "max": 30,
      "step": 5,
      "hint": {
        "en": "Trigger critical battery warning when below this percentage",
        "fr": "Déclencher l'alerte batterie critique en dessous de ce pourcentage"
      }
    },
    {
      "id": "enable_battery_notifications",
      "type": "checkbox",
      "label": {
        "en": "Enable Battery Notifications",
        "nl": "Batterijmeldingen inschakelen",
        "de": "Batteriebenachrichtigungen aktivieren",
        "fr": "Activer Notifications Batterie"
      },
      "value": true,
      "hint": {
        "en": "Send flow notifications for battery events",
        "fr": "Envoyer des notifications de flow pour les événements de batterie"
      }
    },
    {
      "id": "battery_report_interval",
      "type": "number",
      "label": {
        "en": "Battery Report Interval",
        "nl": "Rapportage-interval batterij",
        "de": "Batterie-Berichtsintervall",
        "fr": "Intervalle Rapport Batterie (heures)"
      },
      "value": 24,
      "min": 1,
      "max": 168,
      "step": 1,
      "hint": {
        "en": "How often to request battery status updates",
        "fr": "Fréquence de demande des mises à jour d'état de batterie"
      }
    },
    {
      "id": "optimization_mode",
      "type": "dropdown",
      "label": {
        "en": "Energy Optimization Mode",
        "nl": "Energiebesparingsmodus",
        "de": "Energiesparmodus",
        "fr": "Mode Optimisation Énergétique"
      },
      "value": "balanced",
      "values": [
        {
          "id": "performance",
          "label": {
            "en": "Performance (More responsive)",
            "fr": "Performance (Plus réactif)"
          }
        },
        {
          "id": "balanced",
          "label": {
            "en": "Balanced",
            "fr": "Équilibré"
          }
        },
        {
          "id": "power_saving",
          "label": {
            "en": "Power Saving (Longer battery)",
            "fr": "Économie d'énergie (Batterie plus longue)"
          }
        }
      ],
      "hint": {
        "en": "Balance between responsiveness and battery life",
        "fr": "Équilibre entre réactivité et durée de vie de la batterie"
      }
    },
    {
      "id": "enable_power_estimation",
      "type": "checkbox",
      "label": {
        "en": "Enable Power Estimation",
        "nl": "Vermogensschatting inschakelen",
        "de": "Leistungsschätzung aktivieren",
        "fr": "Activer Estimation Puissance"
      },
      "value": true,
      "hint": {
        "en": "Estimate power consumption when real measurement is not available (AC/DC devices only)",
        "fr": "Estimer la consommation quand la mesure réelle n'est pas disponible (appareils AC/DC seulement)"
      }
    },
    {
      "$extends": [
        "zcl_cluster_layer"
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Adaptive lighting",
        "fr": "Éclairage adaptatif",
        "de": "Adaptive Beleuchtung",
        "nl": "Adaptieve verlichting"
      },
      "children": [
        {
          "id": "adaptive_lighting",
          "type": "checkbox",
          "value": true,
          "label": {
            "en": "Follow the sun (colour temperature)",
            "fr": "Suivre le soleil (température de couleur)",
            "de": "Dem Sonnenlauf folgen (Farbtemperatur)",
            "nl": "De zon volgen (kleurtemperatuur)"
          },
          "hint": {
            "en": "On by default. Nothing changes until the light is next switched on; a manual change pauses it for 60 min. Untick to disable for this light (global switch: app settings).",
            "fr": "Actif par défaut. Rien ne change avant le prochain allumage ; un réglage manuel le met en pause 60 min. Décochez pour désactiver sur cette lampe (interrupteur global : réglages de l'app)."
          }
        },
        {
          "id": "adaptive_brightness",
          "type": "checkbox",
          "value": false,
          "label": {
            "en": "Also adapt brightness",
            "fr": "Adapter aussi la luminosité",
            "de": "Auch die Helligkeit anpassen",
            "nl": "Ook de helderheid aanpassen"
          },
          "hint": {
            "en": "Off by default. Dimmer-only lights only adapt when this is on.",
            "fr": "Désactivé par défaut. Les lampes sans température de couleur ne s'adaptent que si cette option est active."
          }
        }
      ]
    }
  ],
  "images": {
    "small": "/drivers/led_strip_advanced/assets/images/small.png",
    "large": "/drivers/led_strip_advanced/assets/images/large.png"
  },
  "platforms": [
    "local"
  ],
  "connectivity": [
    "zigbee"
  ],
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "select_driver"
      }
    },
    {
      "id": "select_driver",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "capabilitiesOptions": {
    "onoff": {
      "setOnDim": true
    },
    "button.1": {
      "title": {
        "en": "Button 1",
        "fr": "Bouton 1"
      },
      "maintenanceAction": true,
      "getable": false,
      "setable": false
    }
  },
