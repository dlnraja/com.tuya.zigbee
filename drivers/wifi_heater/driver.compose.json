{
  "name": {
    "en": "WiFi Heater (Tuya Local)",
    "fr": "Radiateur WiFi (Tuya Local)",
    "nl": "WiFi Verwarming (Tuya Lokaal)",
    "de": "WiFi Heizung (Tuya Lokal)"
  },
  "class": "heater",
  "capabilities": [
    "onoff",
    "target_temperature",
    "measure_temperature",
    "wifi_heater_mode",
    "child_lock",
    "eco_mode",
    "button.1"
  ],
  "capabilitiesOptions": {
    "target_temperature": {
      "min": 5,
      "max": 35,
      "step": 1
    },
    "button.1": {
      "title": {
        "en": "Button 1",
        "fr": "Bouton 1"
      },
      "maintenanceAction": true,
      "getable": false,
      "setable": false
    }
  },
  "pair": [
    {
      "id": "configure",
      "navigation": {
        "next": "list_devices"
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "prev": "configure"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "repair": [
    {
      "id": "configure"
    }
  ],
