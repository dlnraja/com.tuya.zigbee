      "image": "{{driverAssetsPath}}/icon.svg",
      "instruction": {
        "en": "Switch the light off and on 3–5 times until it blinks to enter pairing mode.",
        "fr": "Éteignez et rallumez la lampe 3 à 5 fois jusqu'à ce qu'elle clignote pour passer en mode appairage.",
