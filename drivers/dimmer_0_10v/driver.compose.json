{
  "name": {
    "en": "0-10V Dimmer",
    "fr": "Variateur 0-10V"
  },
  "class": "light",
  "capabilities": [
    "onoff",
    "dim",
    "button.1"
  ],
  "capabilitiesOptions": {
    "dim": {
      "opts": {
        "duration": true
      }
    },
    "button.1": {
      "title": {
        "en": "Button 1",
        "fr": "Bouton 1"
      },
      "maintenanceAction": true,
      "getable": false,
      "setable": false
    },
    "measure_battery": {
      "title": {
        "en": "Battery",
        "fr": "Batterie",
        "nl": "Batterij",
        "de": "Batterie"
      }
    }
  },
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Brightness Limits",
        "fr": "Limites de Luminosité"
      },
      "children": [
        {
          "id": "minBrightness",
          "type": "number",
          "label": {
            "en": "Minimum Brightness (%)",
            "fr": "Luminosité minimale (%)"
          },
          "value": 0,
          "attr": {
            "step": 1,
            "min": 0,
            "max": 100
          }
        },
        {
          "id": "maxBrightness",
          "type": "number",
          "label": {
            "en": "Maximum Brightness (%)",
            "fr": "Luminosité maximale (%)"
          },
          "value": 100,
          "attr": {
            "step": 1,
            "min": 0,
            "max": 100
          }
        }
      ]
    },
    {
      "$extends": [
        "zcl_cluster_layer"
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Adaptive lighting",
        "fr": "Éclairage adaptatif",
        "de": "Adaptive Beleuchtung",
        "nl": "Adaptieve verlichting"
      },
      "children": [
        {
          "id": "adaptive_lighting",
          "type": "checkbox",
          "value": true,
          "label": {
            "en": "Follow the sun (colour temperature)",
            "fr": "Suivre le soleil (température de couleur)",
            "de": "Dem Sonnenlauf folgen (Farbtemperatur)",
            "nl": "De zon volgen (kleurtemperatuur)"
          },
          "hint": {
            "en": "On by default. Nothing changes until the light is next switched on; a manual change pauses it for 60 min. Untick to disable for this light (global switch: app settings).",
            "fr": "Actif par défaut. Rien ne change avant le prochain allumage ; un réglage manuel le met en pause 60 min. Décochez pour désactiver sur cette lampe (interrupteur global : réglages de l'app).",
            "de": "Standardmäßig aktiv. Erst beim nächsten Einschalten wirksam; eine manuelle Änderung pausiert es 60 Min. Abwählen, um es für diese Lampe zu deaktivieren (globaler Schalter: App-Einstellungen).",
            "nl": "Standaard aan. Pas actief bij de volgende keer inschakelen; een handmatige wijziging pauzeert het 60 min. Uitvinken om het voor deze lamp uit te zetten (globale schakelaar: app-instellingen)."
          }
        },
        {
          "id": "adaptive_brightness",
          "type": "checkbox",
          "value": false,
          "label": {
            "en": "Also adapt brightness",
            "fr": "Adapter aussi la luminosité",
            "de": "Auch die Helligkeit anpassen",
            "nl": "Ook de helderheid aanpassen"
          },
          "hint": {
            "en": "Off by default. Dimmer-only lights only adapt when this is on.",
            "fr": "Désactivé par défaut. Les lampes sans température de couleur ne s'adaptent que si cette option est active.",
            "de": "Standardmäßig aus. Lampen ohne Farbtemperatur passen sich nur an, wenn dies aktiv ist.",
            "nl": "Standaard uit. Lampen zonder kleurtemperatuur passen zich alleen aan als dit aan staat."
          }
        }
      ]
    }
  ],
  "zigbee": {
    "productId": [
      "TS0601"
    ],
    "endpoints": {
      "1": {
        "clusters": [
          61184
        ],
        "bindings": [
          61184
        ]
      }
    },
    "manufacturerName": [
      "_hybrid_dimmer_0_10v_needs_device_assignment",
      "_HYBRID_DIMMER_0_10V_NEEDS_DEVICE_ASSIGNMENT"
    ]
  },
  "images": {
    "small": "/drivers/dimmer_0_10v/assets/images/small.png",
    "large": "/drivers/dimmer_0_10v/assets/images/large.png"
  },
  "platforms": [
    "local"
  ],
  "connectivity": [
    "zigbee"
  ],
  "id": "dimmer_0_10v",
  "version": "1.0.0",
