{
  "id": "wall_remote_1_gang",
  "name": {
    "en": "1 Gang Wall Remote",
    "fr": "Télécommande murale 1 gang",
    "nl": "1-gangs wandafstandsbediening",
    "de": "1-fach Wandfernbedienung",
    "es": "Mando a distancia de pared 1 gang"
  },
  "class": "remote",
  "platforms": [
    "local"
  ],
  "connectivity": [
    "zigbee"
  ],
  "capabilities": [
    "button.1",
    "measure_battery"
  ],
  "images": {
    "small": "/drivers/wall_remote_1_gang/assets/images/small.png",
    "large": "/drivers/wall_remote_1_gang/assets/images/large.png"
  },
  "energy": {
    "batteries": [
      "CR2032"
    ]
  },
  "zigbee": {
    "manufacturerName": [
      "_tz3400_tk3s5tyg",
      "_TZ3400_TK3S5TYG",
      "_TZ3400_tk3s5tyg",
      "_tz3400_TK3S5TYG"
    ],
    "productId": [
      "TS0041"
    ],
    "endpoints": {
      "1": {
        "clusters": [
          0,
          6
        ]
      }
    },
    "learnmode": {
      "image": "{{driverAssetsPath}}/icon.svg",
      "instruction": {
        "en": "Press the button for aprox 10 seconds (the LED should start blinking)."
      }
    }
  },
  "settings": [
    {
      "id": "button_mode",
      "type": "dropdown",
      "label": {
        "en": "Operating Mode",
        "fr": "Mode de fonctionnement"
      },
      "hint": {
        "en": "Scene Mode allows single/double/long press. Dimmer Mode only supports single press. Auto tries to detect and switch automatically.",
        "fr": "Le mode Scène permet les appuis simples/doubles/longs. Le mode Variateur ne supporte que l'appui simple. Auto tente de détecter et basculer automatiquement."
      },
      "value": "auto",
      "values": [
        {
          "id": "auto",
          "label": {
            "en": "Auto-Detect",
            "fr": "Détection Auto"
          }
        },
        {
          "id": "scene",
          "label": {
            "en": "Scene Mode (Multi-press)",
            "fr": "Mode Scène (Multi-clics)"
          }
        },
        {
          "id": "dimmer",
          "label": {
            "en": "Dimmer Mode",
            "fr": "Mode Variateur"
          }
        }
      ]
    },
    {
      "id": "suppress_release_after_click",
      "type": "checkbox",
      "value": false,
      "label": {
        "en": "Ignore 'released' right after a short click",
        "fr": "Ignorer « relâché » juste après un clic court",
        "nl": "'Losgelaten' direct na een korte klik negeren",
        "de": "'Losgelassen' direkt nach kurzem Klick ignorieren"
      },
      "hint": {
        "en": "Some remotes send 'released' after every click, which can stop an action the click just started (e.g. curtains). When enabled, 'released' is only fired after a long press. Idea credited to Adrian_Rockall's Button+ app (community.homey.app/t/89931).",
        "fr": "Certaines télécommandes envoient « relâché » après chaque clic, ce qui peut arrêter l'action lancée par le clic (ex. volets). Activé : « relâché » n'est émis qu'après un appui long. Idée créditée à l'app Button+ d'Adrian_Rockall."
      }
    }
  ],
  "maintenanceActions": [
    {
      "id": "ota_check",
      "title": {
        "en": "Check Zigbee OTA Update",
        "fr": "Vérifier MàJ OTA",
        "nl": "Controleer op OTA-updates"
      }
    },
    {
      "id": "tuya_revive",
      "title": {
        "en": "Tuya Revive (device recovery)",
        "fr": "Tuya Revive (récupération appareil)",
        "nl": "Tuya Revive (apparaatherstel)",
        "de": "Tuya Revive (Gerätewiederherstellung)"
      }
    },
    {
      "id": "generate_issue_report",
      "title": {
        "en": "Generate support report (GitHub issue)",
        "fr": "Générer rapport de support (issue GitHub)",
        "nl": "Supportrapport genereren (GitHub issue)",
        "de": "Supportbericht erstellen (GitHub Issue)"
      }
    },
    {
      "id": "zigbee_rebind",
      "title": {
        "en": "Re-bind & reconfigure reporting",
        "fr": "Re-lier et reconfigurer les rapports",
        "nl": "Opnieuw binden en rapportage instellen",
        "de": "Neu binden und Reporting konfigurieren"
      }
    }
  ],
  "capabilitiesOptions": {
    "button.1": {
      "title": {
        "en": "Button 1",
        "fr": "Bouton 1",
        "nl": "Knop 1",
        "de": "Taste 1"
      },
      "setable": false,
      "maintenanceAction": true,
      "getable": false
    },
    "measure_battery": {
      "title": {
        "en": "Battery",
        "fr": "Batterie",
        "nl": "Batterij",
        "de": "Batterie"
      },
      "getable": true,
      "preventInsights": false
    }
  },
  "version": "1.0.0"
}
