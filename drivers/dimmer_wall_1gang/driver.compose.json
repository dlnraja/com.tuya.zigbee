    {
      "id": "battery_type",
      "type": "dropdown",
      "label": {
        "en": "Battery Type",
        "fr": "Type de Batterie"
      },
      "value": "auto",
      "values": [
        {
          "id": "auto",
          "label": {
            "en": "Auto Detect",
            "fr": "Détection Automatique"
          }
        },
        {
