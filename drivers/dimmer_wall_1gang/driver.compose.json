          }
        },
        {
          "id": "medium",
          "label": {
            "en": "Medium (2s)",
            "nl": "Gemiddeld (2s)"
          }
        },
        {
          "id": "slow",
          "label": {
            "en": "Slow (5s)",
            "nl": "Langzaam (5s)"
          }
        }
      ]
    }
