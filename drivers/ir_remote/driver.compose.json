{
  "name": {
    "en": "Virtual IR Remote",
    "fr": "Télécommande IR Virtuelle"
  },
  "class": "other",
  "capabilities": [
    "onoff",
    "onoff.ir_learn",
    "button.ir_test",
    "button.1"
  ],
  "capabilitiesOptions": {
    "onoff": {
      "title": {
        "en": "Power",
        "fr": "Alimentation"
      }
    },
    "onoff.ir_learn": {
      "title": {
        "en": "Learning Mode",
        "fr": "Mode Apprentissage"
      },
      "icon": "/assets/icons/learn.svg"
    },
    "button.1": {
      "title": {
        "en": "Button 1",
        "fr": "Bouton 1"
      },
      "maintenanceAction": true,
      "getable": false,
      "setable": false
    },
    "button.ir_test": {
      "setable": false,
      "maintenanceAction": true,
      "getable": false
    }
  },
  "settings": [
    {
      "id": "transport_driver",
      "type": "dropdown",
      "label": {
        "en": "IR sender driver",
        "fr": "Driver émetteur IR"
      },
      "value": "ir_blaster",
      "values": [
        { "id": "ir_blaster", "label": { "en": "Zigbee IR Blaster" } },
        { "id": "blaster_remote", "label": { "en": "Zigbee Blaster Remote" } },
        { "id": "wifi_ir_remote", "label": { "en": "WiFi IR Remote" } }
      ]
    },
    {
      "id": "transport_id",
      "type": "text",
      "label": {
        "en": "IR sender device ID",
        "fr": "ID émetteur IR"
      },
      "value": ""
    },
    {
      "id": "blaster_id",
      "type": "text",
      "label": {
        "en": "Legacy blaster ID (Zigbee)",
        "fr": "ID blaster legacy"
      },
      "value": ""
    },
    {
      "id": "ir_brand",
      "type": "text",
      "label": {
        "en": "Brand",
        "fr": "Marque"
      },
      "value": "Samsung"
    },
    {
      "id": "ir_category",
      "type": "dropdown",
      "label": {
        "en": "Device Category",
        "fr": "Catégorie d'appareil"
      },
      "values": [
        { "id": "TV", "label": { "en": "TV", "fr": "TV" } },
        { "id": "AC", "label": { "en": "AC", "fr": "Climatiseur" } },
        { "id": "Fan", "label": { "en": "Fan", "fr": "Ventilateur" } },
        { "id": "Audio", "label": { "en": "Audio", "fr": "Audio" } },
        { "id": "Light", "label": { "en": "Light", "fr": "Lumière" } }
      ],
      "value": "TV"
    },
    {
      "id": "ir_power_on_name",
      "type": "text",
      "label": { "en": "Power ON learned name" },
      "value": "Power On"
    },
    {
      "id": "ir_power_off_name",
      "type": "text",
      "label": { "en": "Power OFF learned name" },
      "value": "Power Off"
    },
    {
      "id": "ir_power_toggle_name",
      "type": "text",
      "label": { "en": "Power toggle learned name" },
      "value": "Power"
    }
  ],
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "ir_setup"
      }
    },
    {
      "id": "ir_setup"
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "images": {
    "small": "/drivers/ir_remote/assets/images/small.png",
    "large": "/drivers/ir_remote/assets/images/large.png"
  },
  "id": "ir_remote",
  "version": "1.0.0",
  "ui": {
    "quickAction": "onoff"
  }
}
