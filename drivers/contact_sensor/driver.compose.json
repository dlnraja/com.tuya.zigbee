            "fr": "Économie d'énergie (Batterie plus longue)"
          }
        }
      ],
      "hint": {
        "en": "Balance between responsiveness and battery life",
        "fr": "Équilibre entre réactivité et durée de vie de la batterie"
      }
    },
    {
      "id": "enable_power_estimation",
      "type": "checkbox",
      "label": {
        "en": "Enable Power Estimation",
        "fr": "Activer Estimation Puissance"
      },
      "value": true,
      "hint": {
        "en": "Estimate power consumption when real measurement is not available (AC/DC devices only)",
        "fr": "Estimer la consommation quand la mesure réelle n'est pas disponible (appareils AC/DC seulement)"
      }
    },
    {
      "id": "alarm_polarity",
      "type": "dropdown",
      "label": {
        "en": "Alarm polarity",
        "fr": "Polarité alarme",
        "nl": "Alarm polariteit"
      },
      "value": "auto",
      "values": [
        {
          "id": "auto",
          "label": {
            "en": "Auto (lists + smart learn)",
            "fr": "Auto (listes + apprentissage)",
            "nl": "Auto (lijsten + slim leren)"
          }
        },
        {
          "id": "normal",
          "label": {
            "en": "Normal (alarm bit = alarm)",
            "fr": "Normal (bit alarme = alarme)",
            "nl": "Normaal (alarmbit = alarm)"
          }
        },
        {
          "id": "inverted",
          "label": {
            "en": "Inverted (flip signal)",
            "fr": "Inversé (inverser le signal)",
            "nl": "Omgekeerd (signaal omdraaien)"
          }
        }
      ],
      "hint": {
        "en": "Auto uses curated normal/inverted device lists and learns from idle timing. Pick Inverted if the tile stays open when closed.",
        "fr": "Auto utilise les listes d’appareils et apprend selon l’inactivité. Choisir Inversé si la tuile reste ouverte quand fermée."
      }
    },
    {
      "id": "invert_contact",
      "type": "checkbox",
      "label": {
        "en": "Invert Contact State",
        "fr": "Inverser État Contact"
      },
      "value": false,
      "hint": {
        "en": "Toggle against Auto polarity (XOR). Prefer Alarm polarity = Inverted for a hard flip.",
        "fr": "Bascule XOR sur Auto. Préférer Polarité = Inversé pour forcer."
      }
    },
    {
      "id": "debounce_time",
      "type": "number",
      "label": {
        "en": "Debounce Time (seconds)",
        "fr": "Temps Anti-Rebond (secondes)"
      },
      "value": 2,
      "min": 0,
      "max": 10,
      "step": 1,
      "hint": {
        "en": "Time to wait before confirming state change (0=disabled). Increase for unstable sensors.",
        "fr": "Temps d'attente avant de confirmer un changement d'état (0=désactivé). Augmenter pour capteurs instables."
      }
    },
    {
      "id": "reverse_alarm",
      "type": "checkbox",
      "label": {
        "en": "Reverse alarm logic",
        "nl": "Alarm logica omkeren"
      },
      "hint": {
        "en": "Swap open/closed states if sensor reports inverted",
        "nl": "Wissel open/gesloten om indien sensor omgekeerd rapporteert"
      },
      "value": false
    },
    {
      "id": "illuminance_calibration",
      "type": "number",
      "label": {
        "en": "Illuminance calibration (%)",
        "fr": "Calibration luminosité (%)",
        "nl": "Lichtsterkte kalibratie (%)"
      },
      "hint": {
        "en": "Multiplier for the reported lux value (100 = unchanged). Use when the sensor under/over-reports.",
        "fr": "Multiplicateur appliqué à la valeur lux remontée (100 = inchangé).",
        "nl": "Vermenigvuldiger voor de gerapporteerde lux-waarde (100 = ongewijzigd)."
      },
      "value": 100,
      "min": 10,
      "max": 1000
    }
