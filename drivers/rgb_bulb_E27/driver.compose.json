{
  "id": "rgb_bulb_E27",
  "name": {
    "en": "RGB Bulb E27",
    "fr": "Ampoule RGB E27"
  },
  "$extends": [
    "light_color_ambiance"
  ],
  "energy": {
    "approximation": {
      "usageOn": 9,
      "usageOff": 1
    }
  },
  "zigbee": {
    "manufacturerName": [
      "_hybrid_rgb_bulb_E27_needs_device_assignment",
      "_HYBRID_RGB_BULB_E27_NEEDS_DEVICE_ASSIGNMENT"
    ],
    "productId": [
      "TS0505A",
      "TS0505B",
      "ZB-CL01"
    ],
    "endpoints": {
      "1": {
        "clusters": [
          0,
          3,
          4,
          5,
          6,
          8,
          768
        ],
        "bindings": [
          6,
          8,
          768
        ]
      }
    },
    "learnmode": {
      "image": "{{driverAssetsPath}}/icon.svg",
      "instruction": {
        "en": "Power on to enter pairing mode.",
        "fr": "Mettez sous tension pour passer en mode appairage."
      }
    }
  },
  "version": "1.0.0",
  "connectivity": [
    "zigbee"
  ],
  "capabilities": [
    "onoff",
    "dim",
    "light_hue",
    "light_saturation",
    "button.1"
  ],
  "capabilitiesOptions": {
    "button.1": {
      "title": {
        "en": "Button 1",
        "fr": "Bouton 1"
      },
      "maintenanceAction": true,
      "getable": false,
      "setable": false
    },
    "onoff": {
      "setOnDim": false
    }
  },
  "class": "light",
  "ui": {
    "quickAction": "onoff"
  },
  "metadata": {
    "driver": {
      "_comment": "WHY: skip pid strip 2026-08-21 — empty manufacturerName; stripping productIds would leave zero fingerprints. Do not invent mfrs."
    }
  },
  "images": {
    "small": "/drivers/rgb_bulb_E27/assets/images/small.png",
    "large": "/drivers/rgb_bulb_E27/assets/images/large.png"
  },
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Adaptive lighting",
        "fr": "Éclairage adaptatif",
        "de": "Adaptive Beleuchtung",
        "nl": "Adaptieve verlichting"
      },
      "children": [
        {
          "id": "adaptive_lighting",
          "type": "checkbox",
          "value": true,
          "label": {
            "en": "Follow the sun (colour temperature)",
            "fr": "Suivre le soleil (température de couleur)",
            "de": "Dem Sonnenlauf folgen (Farbtemperatur)",
            "nl": "De zon volgen (kleurtemperatuur)"
          },
          "hint": {
            "en": "On by default. Nothing changes until the light is next switched on; a manual change pauses it for 60 min. Untick to disable for this light (global switch: app settings).",
            "fr": "Actif par défaut. Rien ne change avant le prochain allumage ; un réglage manuel le met en pause 60 min. Décochez pour désactiver sur cette lampe (interrupteur global : réglages de l'app)."
          }
        },
        {
          "id": "adaptive_brightness",
          "type": "checkbox",
          "value": false,
          "label": {
            "en": "Also adapt brightness",
            "fr": "Adapter aussi la luminosité",
            "de": "Auch die Helligkeit anpassen",
            "nl": "Ook de helderheid aanpassen"
          },
          "hint": {
            "en": "Off by default. Dimmer-only lights only adapt when this is on.",
            "fr": "Désactivé par défaut. Les lampes sans température de couleur ne s'adaptent que si cette option est active."
          }
        }
      ]
    }
  ]
}
