[
  {
    "type": "group",
    "label": {
      "en": "Dimmer Settings",
      "fr": "Réglages du variateur",
      "nl": "Dimmer Instellingen"
    },
    "children": [
      {
        "id": "min_brightness",
        "type": "number",
        "label": {
          "en": "Minimum Brightness (%)",
          "fr": "Luminosité minimale (%)",
          "nl": "Minimale Helderheid (%)"
        },
        "hint": {
          "en": "Set the minimum brightness level (1-100). Important for LED compatibility.",
          "nl": "Stel het minimale helderheidsniveau in (1-100). Belangrijk voor LED-compatibiliteit."
        },
        "value": 1,
        "min": 1,
        "max": 100,
        "units": "%"
      },
      {
        "id": "power_on_behavior",
        "type": "dropdown",
        "label": {
          "en": "Power-on Behavior",
          "fr": "Comportement à la mise sous tension",
          "nl": "Inschakelen Gedrag"
        },
        "hint": {
          "en": "Select the behavior when power is restored",
          "nl": "Selecteer het gedrag wanneer de stroom wordt hersteld"
        },
        "value": "0",
        "values": [
          {
            "id": "0",
            "label": {
              "en": "Off",
              "nl": "Uit"
            }
          },
          {
            "id": "1",
            "label": {
              "en": "On",
              "nl": "Aan"
            }
          },
          {
            "id": "2",
            "label": {
              "en": "Last State",
              "nl": "Laatste Status"
            }
          }
        ]
      },
      {
        "id": "light_type",
        "type": "dropdown",
        "label": {
          "en": "Light Type",
          "fr": "Type d'éclairage",
          "nl": "Lichttype"
        },
        "hint": {
          "en": "Select the type of light connected",
          "nl": "Selecteer het type aangesloten lamp"
        },
        "value": "0",
        "values": [
          {
            "id": "0",
            "label": {
              "en": "LED",
              "nl": "LED"
            }
          },
          {
            "id": "1",
            "label": {
              "en": "Incandescent",
              "nl": "Gloeilamp"
            }
          },
          {
            "id": "2",
            "label": {
              "en": "Halogen",
              "nl": "Halogeen"
            }
          }
        ]
      }
    ]
  },
  {
    "type": "group",
    "label": {
      "en": "💡 LED Indicator (Backlight)",
      "fr": "💡 Voyant LED (rétroéclairage)",
      "nl": "💡 LED-indicator (Achtergrondverlichting)"
    },
    "children": [
      {
        "id": "backlight_mode",
        "type": "dropdown",
        "label": {
          "en": "LED Indicator Mode",
          "fr": "Mode du voyant LED",
          "nl": "LED-indicator Modus"
        },
        "hint": {
          "en": "Control when the LED indicator on the switch is lit",
          "nl": "Bepaal wanneer de LED-indicator op de schakelaar brandt"
        },
        "value": "normal",
        "values": [
          {
            "id": "off",
            "label": {
              "en": "Always Off",
              "nl": "Altijd Uit"
            }
          },
          {
            "id": "normal",
            "label": {
              "en": "On when Light ON (Normal)",
              "nl": "Aan wanneer Licht AAN (Normaal)"
            }
          },
          {
            "id": "inverted",
            "label": {
              "en": "On when Light OFF (Inverted)",
              "nl": "Aan wanneer Licht UIT (Omgekeerd)"
            }
          }
        ]
      }
    ]
  },
  {
    "$extends": [
      "zcl_cluster_layer"
    ]
  },
  {
    "type": "group",
    "label": {
      "en": "Adaptive lighting",
      "fr": "Éclairage adaptatif",
      "de": "Adaptive Beleuchtung",
      "nl": "Adaptieve verlichting"
    },
    "children": [
      {
        "id": "adaptive_lighting",
        "type": "checkbox",
        "value": true,
        "label": {
          "en": "Follow the sun (colour temperature)",
          "fr": "Suivre le soleil (température de couleur)",
          "de": "Dem Sonnenlauf folgen (Farbtemperatur)",
          "nl": "De zon volgen (kleurtemperatuur)"
        },
        "hint": {
          "en": "On by default. Nothing changes until the light is next switched on; a manual change pauses it for 60 min. Untick to disable for this light (global switch: app settings).",
          "fr": "Actif par défaut. Rien ne change avant le prochain allumage ; un réglage manuel le met en pause 60 min. Décochez pour désactiver sur cette lampe (interrupteur global : réglages de l'app)."
        }
      },
      {
        "id": "adaptive_brightness",
        "type": "checkbox",
        "value": false,
        "label": {
          "en": "Also adapt brightness",
          "fr": "Adapter aussi la luminosité",
          "de": "Auch die Helligkeit anpassen",
          "nl": "Ook de helderheid aanpassen"
        },
        "hint": {
          "en": "Off by default. Dimmer-only lights only adapt when this is on.",
          "fr": "Désactivé par défaut. Les lampes sans température de couleur ne s'adaptent que si cette option est active."
        }
      }
    ]
  }
]