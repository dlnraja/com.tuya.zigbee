{
  "name": {
    "en": "WiFi Power Strip (Tuya Local)",
    "fr": "Multiprise WiFi (Tuya Local)",
    "nl": "WiFi-stekkerdoos (Tuya Lokaal)",
    "de": "WiFi-Steckdosenleiste (Tuya Lokal)",
    "es": "Regleta WiFi (Tuya Local)"
  },
  "class": "socket",
  "capabilities": [
    "onoff",
    "onoff.socket2",
    "onoff.socket3",
    "onoff.socket4",
    "measure_power",
    "meter_power",
    "power_on_behavior",
    "button.1"
  ],
  "capabilitiesOptions": {
    "onoff": {
      "title": {
        "en": "Socket 1"
      }
    },
    "onoff.socket2": {
      "title": {
        "en": "Socket 2"
      }
    },
    "onoff.socket3": {
      "title": {
        "en": "Socket 3"
      }
    },
    "onoff.socket4": {
      "title": {
        "en": "Socket 4"
      }
    },
    "button.1": {
      "title": {
        "en": "Button 1",
        "fr": "Bouton 1"
      },
      "maintenanceAction": true,
      "getable": false,
      "setable": false
    },
    "measure_power": {
      "getable": true,
      "preventInsights": false
    },
    "meter_power": {
      "getable": true,
      "preventInsights": false
    }
  },
  "pair": [
    {
      "id": "configure",
      "navigation": {
        "next": "list_devices"
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "prev": "configure"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "repair": [
    {
      "id": "configure"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Tuya Local"
      },
      "children": [
        {
          "id": "device_id",
          "type": "text",
          "label": {
            "en": "Device ID"
          },
          "value": ""
        },
        {
          "id": "local_key",
          "type": "text",
          "label": {
            "en": "Local Key"
          },
          "value": ""
        },
        {
          "id": "ip",
          "type": "text",
          "label": {
            "en": "IP"
          },
          "value": ""
        },
        {
          "id": "protocol_version",
          "type": "dropdown",
          "label": {
            "en": "Protocol"
          },
          "value": "auto",
          "values": [
            {
              "id": "auto",
              "label": {
                "en": "Auto (3.1-3.5)"
              }
            },
            {
              "id": "3.1",
              "label": {
                "en": "3.1"
              }
            },
            {
              "id": "3.3",
              "label": {
                "en": "3.3"
              }
            },
            {
              "id": "3.4",
              "label": {
                "en": "3.4"
              }
            },
            {
              "id": "3.5",
              "label": {
                "en": "3.5"
              }
            }
          ]
        },
        {
          "id": "command_gap_ms",
          "type": "number",
          "label": {
            "en": "Command Gap (ms)",
            "fr": "Écart entre commandes (ms)",
            "nl": "Opdracht-interval (ms)",
            "de": "Befehlsabstand (ms)"
          },
          "value": 100,
          "min": 0,
          "max": 10000,
          "units": {
            "en": "ms"
          },
          "hint": {
            "en": "Minimum gap between two LAN commands. Helps firmware that silently drops rapid SETs (protocol 3.4/3.5).",
            "fr": "Délai minimum entre deux commandes LAN. Évite les SET perdus sur protocole 3.4/3.5."
          }
        },
        {
          "id": "offline_grace_seconds",
          "type": "number",
          "label": {
            "en": "Offline Grace (seconds)",
            "fr": "Délai hors-ligne (s)",
            "nl": "Offline-grace (s)",
            "de": "Offline-Karenz (s)"
          },
          "value": 60,
          "min": 0,
          "max": 600,
          "units": {
            "en": "s"
          },
          "hint": {
            "en": "Delay before marking unavailable / firing disconnect flows after a brief TCP drop (pet feeders, dehumidifiers).",
            "fr": "Délai avant indisponible / flux déconnecté après une brève coupure TCP (pet feeders, déshumidificateurs)."
          }
        }
      ]
    },
    {
      "id": "power_scale",
      "type": "dropdown",
      "label": {
        "en": "Power Measurement Scale",
        "fr": "Échelle de puissance"
      },
      "value": "1",
      "values": [
        {
          "id": "0.1",
          "label": {
            "en": "÷10",
            "fr": "÷10"
          }
        },
        {
          "id": "1",
          "label": {
            "en": "×1 (Default)",
            "fr": "×1 (défaut)"
          }
        },
        {
          "id": "10",
          "label": {
            "en": "×10",
            "fr": "×10"
          }
        }
      ],
      "hint": {
        "en": "Use if W/kWh readings are 10× too high or low.",
        "fr": "Si W/kWh sont ×10 trop hauts ou bas."
      }
    }
  ],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "images": {
    "small": "/drivers/wifi_power_strip/assets/images/small.png",
