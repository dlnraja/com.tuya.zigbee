{
  "name": {
    "en": "Air Purifier Curtain",
    "nl": "Luchtzuiverende Gordijn",
    "fr": "Rideau Purificateur d'Air",
    "de": "Luftreiniger Vorhang",
    "es": "Cortina Híbrida Purificadora de Aire"
  },
  "class": "windowcoverings",
  "capabilities": [
    "windowcoverings_state",
    "windowcoverings_set",
    "windowcoverings_tilt_set",
    "measure_battery"
  ],
  "images": {
    "small": "/drivers/curtain_motor_tilt/assets/images/small.png",
    "large": "/drivers/curtain_motor_tilt/assets/images/large.png"
  },
  "platforms": [
    "local"
  ],
  "energy": {
    "batteries": [
      "CR2450"
    ]
  },
  "flow": {
    "actions": [
      {
        "id": "air_purifier_curtain_curtain_calibrate",
        "title": {
          "en": "Calibrate curtain motor",
          "nl": "Kalibreer gordijnmotor",
          "fr": "Calibrer le moteur du rideau"
        },
        "hint": {
          "en": "Run full open/close cycle for position calibration",
          "nl": "Voer volledige open/sluit cyclus uit voor positie kalibratie",
          "fr": "Effectuer un cycle complet ouverture/fermeture pour calibrer la position"
        }
      },
      {
        "id": "air_purifier_curtain_curtain_reset_position",
        "title": {
          "en": "Reset position to 0%",
          "nl": "Reset positie naar 0%",
          "fr": "Réinitialiser la position à 0 %"
        },
        "hint": {
          "en": "Reset current position to fully closed",
          "nl": "Reset huidige positie naar volledig gesloten",
          "fr": "Réinitialiser la position actuelle à complètement fermé"
        }
      },
      {
        "id": "air_purifier_curtain_curtain_hold",
        "title": {
          "en": "Hold curtain position",
          "nl": "Gordijn positie vasthouden",
          "fr": "Maintenir position rideau"
        },
        "hint": {
          "en": "Stop curtain movement and hold at current position",
          "nl": "Stop gordijn beweging en houd huidige positie vast",
          "fr": "Arrêter le rideau et le maintenir à sa position actuelle"
        }
      },
      {
        "id": "air_purifier_curtain_curtain_open_partial",
        "title": {
          "en": "Open curtain partially",
          "nl": "Gordijn gedeeltelijk openen",
          "fr": "Ouvrir rideau partiellement"
        },
        "args": [
          {
            "type": "range",
            "name": "position",
            "min": 0,
            "max": 100,
            "step": 1,
            "label": "%",
            "labelMultiplier": 1,
            "title": {
              "en": "Position",
              "fr": "Position"
            }
          }
        ],
        "titleFormatted": {
          "en": "Open curtain partially [[position]]",
          "fr": "Ouvrir rideau partiellement [[position]]"
        }
      }
    ],
    "triggers": [],
    "conditions": []
  },
  "maintenanceActions": [
    {
      "id": "ota_check",
      "title": {
        "en": "Check Zigbee OTA Update",
        "fr": "Vérifier MàJ OTA",
        "nl": "Controleer op OTA-updates"
      }
    },
    {
      "id": "tuya_revive",
      "title": {
        "en": "Tuya Revive (device recovery)",
        "fr": "Tuya Revive (récupération appareil)",
        "nl": "Tuya Revive (apparaatherstel)",
        "de": "Tuya Revive (Gerätewiederherstellung)"
      }
    },
    {
      "id": "generate_issue_report",
      "title": {
        "en": "Generate support report (GitHub issue)",
        "fr": "Générer rapport de support (issue GitHub)",
        "nl": "Supportrapport genereren (GitHub issue)",
        "de": "Supportbericht erstellen (GitHub Issue)"
      }
    }
  ],
  "settings": [
    {
      "id": "keep_position_slider",
      "type": "checkbox",
      "value": false,
      "label": {
        "en": "Always keep the position slider",
        "fr": "Toujours garder le curseur de position",
        "nl": "Positieschuif altijd behouden",
        "de": "Positionsregler immer behalten"
      },
      "hint": {
        "en": "Off (default): the position slider is hidden when the curtain never reports a position (open/stop/close only) after sustained use. On: never hide it.",
        "fr": "Désactivé (défaut) : le curseur est masqué si le rideau ne signale jamais de position (ouvrir/stop/fermer uniquement) après un usage prolongé. Activé : jamais masqué.",
        "nl": "Uit (standaard): de positieschuif wordt verborgen als het gordijn na langer gebruik nooit een positie meldt (alleen open/stop/dicht). Aan: nooit verbergen.",
        "de": "Aus (Standard): Der Positionsregler wird ausgeblendet, wenn der Vorhang nach längerer Nutzung nie eine Position meldet (nur Auf/Stopp/Zu). An: nie ausblenden."
      }
    }
  ],
  "id": "air_purifier_curtain",
  "version": "1.0.0",
  "connectivity": [
    "zigbee"
  ],
  "zigbee": {
    "productId": [
      "TS0601"
    ],
    "endpoints": {
      "1": {
        "clusters": [
          0
        ]
      }
    },
    "manufacturerName": [],
    "learnmode": {
      "image": "{{driverAssetsPath}}/icon.svg",
      "instruction": {
        "en": "Press the motor pairing button (or P2 twice) until the motor jogs / LED flashes, then start pairing in Homey.",
        "fr": "Bouton moteur (ou P2×2) jusqu'à jog/LED, puis lancez l'appairage Homey.",
        "nl": "Motor-paarknop (of P2×2) tot jog/LED, start daarna Homey-pairing.",
        "de": "Motor-Pairingtaste (oder P2×2) bis Ruck/LED, dann Homey-Pairing starten."
      }
    }
  },
  "metadata": {
    "driver": {
      "catchall": true,
      "reason": "Fallback for unmatched curtain devices with PID: TS0601"
    }
  },
  "capabilitiesOptions": {
    "button.1": {
      "title": {
        "en": "Button 1",
        "fr": "Bouton 1"
      },
      "maintenanceAction": true,
      "getable": false,
      "setable": false
    },
    "measure_battery": {
      "getable": true,
      "preventInsights": false
    }
  },
  "ui": {},
  "deprecated": true
}
