{
  "id": "bulb_zbeacon_ts0505b",
  "name": {
    "en": "RGB+CCT Bulb (Zbeacon TS0505B)",
    "fr": "Ampoule RGB+CCT (Zbeacon TS0505B)",
    "nl": "RGB+CCT lamp (Zbeacon TS0505B)"
  },
  "class": "light",
  "platforms": [
    "local"
  ],
  "connectivity": [
    "zigbee"
  ],
  "capabilities": [
    "onoff",
    "dim",
    "light_hue",
    "light_saturation",
    "light_temperature",
    "light_mode"
  ],
  "capabilitiesOptions": {
    "onoff": {
      "setOnDim": true
    }
  },
  "energy": {
    "approximation": {
      "usageOn": 12,
      "usageOff": 0.4
    }
  },
  "images": {
    "small": "/drivers/bulb_zbeacon_ts0505b/assets/images/small.png",
    "large": "/drivers/bulb_zbeacon_ts0505b/assets/images/large.png"
  },
  "zigbee": {
    "manufacturerName": [
      "Zbeacon",
      "zbeacon",
      "ZBEACON"
    ],
    "productId": [
      "TS0505B"
    ],
    "endpoints": {
      "1": {
        "clusters": [
          0,
          3,
          4,
          5,
          6,
          8,
          768
        ]
      }
    },
    "learnmode": {
      "image": "{{driverAssetsPath}}/icon.svg",
      "instruction": {
        "en": "Switch the bulb off and on 5 times until it blinks.",
        "fr": "Éteignez et rallumez l’ampoule 5 fois jusqu’à ce qu’elle clignote.",
        "nl": "Zet de lamp 5 keer uit en aan tot ze knippert."
      }
    }
  },
  "metadata": {
    "source": "Z2S library supported-devices (TS0505B|Zbeacon = Tuya RGBW bulb model B); interview EP1 in 0,3,4,5,6,8,768,4096,0xFC01,0xFC03 (PC harvest r2); docs/rules/PCR2_MISSING_DEVICES_2026-10-04.md"
  },
  "settings": [
    {
      "$extends": [
        "zcl_cluster_layer"
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Adaptive lighting",
        "fr": "Éclairage adaptatif",
        "de": "Adaptive Beleuchtung",
        "nl": "Adaptieve verlichting"
      },
      "children": [
        {
          "id": "adaptive_lighting",
          "type": "checkbox",
          "value": true,
          "label": {
            "en": "Follow the sun (colour temperature)",
            "fr": "Suivre le soleil (température de couleur)",
            "de": "Dem Sonnenlauf folgen (Farbtemperatur)",
            "nl": "De zon volgen (kleurtemperatuur)"
          },
          "hint": {
            "en": "On by default. Nothing changes until the light is next switched on; a manual change pauses it for 60 min. Untick to disable for this light (global switch: app settings).",
            "fr": "Actif par défaut. Rien ne change avant le prochain allumage ; un réglage manuel le met en pause 60 min. Décochez pour désactiver sur cette lampe (interrupteur global : réglages de l'app)."
          }
        },
        {
          "id": "adaptive_brightness",
          "type": "checkbox",
          "value": false,
          "label": {
            "en": "Also adapt brightness",
            "fr": "Adapter aussi la luminosité",
            "de": "Auch die Helligkeit anpassen",
            "nl": "Ook de helderheid aanpassen"
          },
          "hint": {
            "en": "Off by default. Dimmer-only lights only adapt when this is on.",
            "fr": "Désactivé par défaut. Les lampes sans température de couleur ne s'adaptent que si cette option est active."
          }
        }
      ]
    }
  ]
}
