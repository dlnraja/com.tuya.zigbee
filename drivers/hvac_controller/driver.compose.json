{
  "name": {
    "en": "HVAC Controller",
    "fr": "Contrôleur HVAC",
    "nl": "HVAC Controller",
    "de": "HVAC Steuerung"
  },
  "class": "thermostat",
  "capabilities": [
    "onoff",
    "target_temperature",
    "measure_temperature",
    "thermostat_mode",
    "button.1"
  ],
  "capabilitiesOptions": {
    "target_temperature": {
      "min": 16,
      "max": 30,
      "step": 0.5
    },
    "thermostat_mode": {
      "values": [
        {
          "id": "auto",
          "title": {
            "en": "Auto"
          }
        },
        {
          "id": "cool",
          "title": {
            "en": "Cool"
          }
        },
        {
          "id": "heat",
          "title": {
            "en": "Heat"
          }
        },
        {
          "id": "off",
          "title": {
            "en": "Off"
          }
        }
      ]
    },
    "button.1": {
      "title": {
        "en": "Button 1",
        "fr": "Bouton 1"
      },
      "maintenanceAction": true,
      "getable": false,
      "setable": false
    },
    "measure_temperature": {
      "getable": true,
      "preventInsights": false
    }
  },
  "zigbee": {
    "manufacturerName": [
      "_tze200_cfczgbss",
      "_tze284_cfczgbss",
      "_TZE200_CFCZGBSS",
      "_TZE284_CFCZGBSS",
      "_TZE200_cfczgbss",
      "_TZE284_cfczgbss"
    ],
    "productId": [
      "TS0601"
    ],
    "endpoints": {
      "1": {
        "clusters": [
          0,
          6
        ]
      }
    }
  },
  "images": {
    "small": "/drivers/hvac_controller/assets/images/small.png",
    "large": "/drivers/hvac_controller/assets/images/large.png",
    "xlarge": "/drivers/hvac_controller/assets/images/xlarge.png"
  },
  "platforms": [
    "local"
  ],
  "connectivity": [
    "zigbee"
  ],
  "energy": {
    "approximation": {
      "usageConstant": 5
    }
  },
  "maintenanceActions": [
    {
      "id": "ota_check",
      "title": {
        "en": "Check Zigbee OTA Update",
        "fr": "Vérifier MàJ OTA",
        "nl": "Controleer op OTA-updates"
      }
    },
    {
      "id": "tuya_revive",
      "title": {
        "en": "Tuya Revive (device recovery)",
        "fr": "Tuya Revive (récupération appareil)"
      }
    },
    {
      "id": "generate_issue_report",
      "title": {
        "en": "Generate support report (GitHub issue)",
        "fr": "Générer rapport de support (issue GitHub)"
      }
    },
    {
      "id": "zigbee_rebind",
      "title": {
        "en": "Re-bind & reconfigure reporting",
        "fr": "Re-lier et reconfigurer les rapports",
        "nl": "Opnieuw binden en rapportage instellen",
        "de": "Neu binden und Reporting konfigurieren"
      }
    }
  ],
  "id": "hvac_controller",
  "version": "1.0.0",
  "ui": {
    "quickAction": "onoff"
  },
  "settings": [
    {
      "id": "tuya_time_sync",
      "type": "checkbox",
      "value": true,
      "label": {
        "en": "Send time to the device",
        "fr": "Envoyer l'heure à l'appareil"
      },
      "hint": {
        "en": "Turn off only if the device misbehaves after a time sync (clock jumps, schedule resets).",
        "fr": "Désactivez seulement si l'appareil se comporte mal après une synchronisation de l'heure (horloge qui saute, programme réinitialisé)."
      }
    }
  ]
}
