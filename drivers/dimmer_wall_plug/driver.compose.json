{
  "name": {
    "en": "Dimmer Wall Plug",
    "nl": "Dimmer Wandstopcontact",
    "fr": "Prise Murale Dimmer",
    "de": "Dimmer Wandstecker",
    "es": "Enchufe de Pared Regulable"
  },
  "class": "socket",
  "capabilities": [
    "measure_power",
    "meter_power",
    "measure_voltage",
    "measure_current",
    "onoff",
    "dim",
    "button.1"
  ],
  "energy": {
    "mains": true
  },
  "settings": [
    {
      "id": "enable_power_estimation",
      "type": "checkbox",
      "label": {
        "en": "Enable Power Estimation",
        "nl": "Vermogensschatting inschakelen",
        "de": "Leistungsschätzung aktivieren",
        "fr": "Activer Estimation Puissance"
      },
      "value": true,
      "hint": {
        "en": "Estimate power consumption when real measurement is not available (AC/DC devices only)",
        "fr": "Estimer la consommation quand la mesure réelle n'est pas disponible (appareils AC/DC seulement)"
      }
    },
    {
      "id": "power_scale",
      "type": "dropdown",
      "label": {
        "en": "Power Measurement Scale",
        "nl": "Schaal vermogensmeting",
        "de": "Skalierung der Leistungsmessung",
        "fr": "Échelle Mesure Puissance"
      },
      "value": "1",
      "values": [
        {
          "id": "0.1",
          "label": {
            "en": "÷10",
            "fr": "÷10"
          }
        },
        {
          "id": "1",
          "label": {
            "en": "×1 (Default)",
            "fr": "×1 (Par défaut)"
          }
        },
        {
          "id": "10",
          "label": {
            "en": "×10",
            "fr": "×10"
          }
        }
      ],
      "hint": {
        "en": "Adjust if power readings are way off.",
        "fr": "Ajuster si les mesures de puissance sont incorrectes."
      }
    },
    {
      "id": "voltage_scale",
      "type": "dropdown",
      "label": {
        "en": "Voltage Measurement Scale",
        "fr": "Échelle Mesure Tension"
      },
      "value": "1",
      "values": [
        {
          "id": "0.1",
          "label": {
            "en": "÷10",
            "fr": "÷10"
          }
        },
        {
          "id": "1",
          "label": {
            "en": "×1 (Default)",
            "fr": "×1 (Par défaut)"
          }
        },
        {
          "id": "10",
          "label": {
            "en": "×10",
            "fr": "×10"
          }
        }
      ],
      "hint": {
        "en": "Adjust if voltage readings are way off.",
        "fr": "Ajuster si les mesures de tension sont incorrectes."
      }
    },
    {
      "id": "current_scale",
      "type": "dropdown",
      "label": {
        "en": "Current Measurement Scale",
        "fr": "Échelle Mesure Courant"
      },
      "value": "1",
      "values": [
        {
          "id": "0.1",
          "label": {
            "en": "÷10",
            "fr": "÷10"
          }
        },
        {
          "id": "1",
          "label": {
            "en": "×1 (Default)",
            "fr": "×1 (Par défaut)"
          }
        },
        {
          "id": "10",
          "label": {
            "en": "×10",
            "fr": "×10"
          }
        }
      ],
      "hint": {
        "en": "Adjust if current readings are way off.",
        "fr": "Ajuster si les mesures de courant sont incorrectes."
      }
    },
    {
      "id": "meter_power_scale",
      "type": "dropdown",
      "label": {
        "en": "Energy (kWh) Scale",
        "fr": "Échelle Énergie (kWh)"
      },
      "value": "1",
      "values": [
        {
          "id": "0.1",
          "label": {
            "en": "÷10",
            "fr": "÷10"
          }
        },
        {
          "id": "1",
          "label": {
            "en": "×1 (Default)",
            "fr": "×1 (Par défaut)"
          }
        },
        {
          "id": "10",
          "label": {
            "en": "×10",
            "fr": "×10"
          }
        }
      ],
      "hint": {
        "en": "Adjust if total energy (kWh) readings are way off.",
        "fr": "Ajuster si l'énergie totale (kWh) est incorrecte."
      }
    },
    {
      "$extends": [
        "zcl_cluster_layer"
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Adaptive lighting",
        "fr": "Éclairage adaptatif",
        "de": "Adaptive Beleuchtung",
        "nl": "Adaptieve verlichting"
      },
      "children": [
        {
          "id": "adaptive_lighting",
          "type": "checkbox",
          "value": true,
          "label": {
            "en": "Follow the sun (colour temperature)",
            "fr": "Suivre le soleil (température de couleur)",
            "de": "Dem Sonnenlauf folgen (Farbtemperatur)",
            "nl": "De zon volgen (kleurtemperatuur)"
          },
          "hint": {
            "en": "On by default. Nothing changes until the light is next switched on; a manual change pauses it for 60 min. Untick to disable for this light (global switch: app settings).",
            "fr": "Actif par défaut. Rien ne change avant le prochain allumage ; un réglage manuel le met en pause 60 min. Décochez pour désactiver sur cette lampe (interrupteur global : réglages de l'app)."
          }
        },
        {
          "id": "adaptive_brightness",
          "type": "checkbox",
          "value": false,
          "label": {
            "en": "Also adapt brightness",
            "fr": "Adapter aussi la luminosité",
            "de": "Auch die Helligkeit anpassen",
            "nl": "Ook de helderheid aanpassen"
          },
          "hint": {
            "en": "Off by default. Dimmer-only lights only adapt when this is on.",
            "fr": "Désactivé par défaut. Les lampes sans température de couleur ne s'adaptent que si cette option est active."
          }
        }
      ]
    },
    {
      "id": "energy_source",
      "type": "label",
      "value": "default",
      "label": {
        "en": "Power value source",
        "fr": "Origine de la puissance",
        "de": "Herkunft des Leistungswerts",
        "nl": "Bron van de vermogenswaarde"
      }
    }
  ],
  "images": {
    "small": "/drivers/plug_energy_monitor/assets/images/small.png",
    "large": "/drivers/plug_energy_monitor/assets/images/large.png"
  },
  "platforms": [
    "local"
  ],
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "select_driver"
      }
    },
    {
      "id": "select_driver",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "capabilitiesOptions": {
    "button.1": {
      "title": {
        "en": "Button 1",
        "fr": "Bouton 1"
      },
      "maintenanceAction": true,
      "getable": false,
      "setable": false
    },
    "measure_power": {
      "approximated": true,
      "getable": true,
      "preventInsights": false
    },
    "meter_power": {
      "getable": true,
      "preventInsights": false
    },
    "measure_voltage": {
      "getable": true,
      "preventInsights": false
    },
    "measure_current": {
      "getable": true,
      "preventInsights": false
    }
  },
  "maintenanceActions": [
    {
      "id": "ota_check",
      "title": {
        "en": "Check Zigbee OTA Update",
        "fr": "Vérifier MàJ OTA",
        "nl": "Controleer op OTA-updates"
      }
    },
    {
      "id": "tuya_revive",
      "title": {
        "en": "Tuya Revive (device recovery)",
        "fr": "Tuya Revive (récupération appareil)",
        "nl": "Tuya Revive (apparaatherstel)",
        "de": "Tuya Revive (Gerätewiederherstellung)"
      }
    },
    {
      "id": "generate_issue_report",
      "title": {
        "en": "Generate support report (GitHub issue)",
        "fr": "Générer rapport de support (issue GitHub)",
        "nl": "Supportrapport genereren (GitHub issue)",
        "de": "Supportbericht erstellen (GitHub Issue)"
      }
    },
    {
      "id": "zigbee_rebind",
      "title": {
        "en": "Re-bind & reconfigure reporting",
        "fr": "Re-lier et reconfigurer les rapports",
        "nl": "Opnieuw binden en rapportage instellen",
        "de": "Neu binden und Reporting konfigurieren"
      }
    }
  ],
  "id": "dimmer_wall_plug",
  "version": "1.0.0",
  "connectivity": [
    "zigbee"
  ],
  "zigbee": {
    "productId": [
      "TS0601"
    ],
    "endpoints": {
      "1": {
        "clusters": [
          0
        ]
      }
    },
    "manufacturerName": [
      "_TZ3000_ga5shatp",
      "_TZ3000_GA5SHATP",
      "_tz3000_ga5shatp",
      "_tz3000_GA5SHATP"
    ],
    "learnmode": {
      "image": "{{driverAssetsPath}}/icon.svg",
      "instruction": {
        "en": "Power-cycle the light 3–5 times until it flashes, or hold the reset button on the controller.",
        "fr": "Coupez/rétablissez l'alim. 3–5 fois jusqu'à clignotement, ou maintenez reset.",
        "nl": "Schakel de lamp 3–5× uit/aan tot knipperen, of houd reset vast.",
        "de": "Lampe 3–5× netzschalten bis Blinken, oder Reset halten."
      }
    }
  },
  "ui": {
    "quickAction": "onoff"
  }
}
