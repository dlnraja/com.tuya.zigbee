{
  "name": {
    "en": "WiFi Light RGBCW (Tuya Local)",
    "fr": "Lumière WiFi RGBCW (Tuya Local)",
    "nl": "WiFi-lamp RGBCW (Tuya Lokaal)",
    "de": "WiFi-Licht RGBCW (Tuya Lokal)",
    "es": "Luz WiFi RGBCW (Tuya Local)"
  },
  "class": "light",
  "energy": {
    "approximation": {
      "usageOn": 7,
      "usageOff": 0.4
    }
  },
  "capabilities": [
    "onoff",
    "dim",
    "light_hue",
    "light_saturation",
    "light_temperature",
    "light_mode",
    "button.1"
  ],
  "pair": [
    {
      "id": "configure",
      "navigation": {
        "next": "list_devices"
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "prev": "configure"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "repair": [
    {
      "id": "configure"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Tuya Local",
        "fr": "Tuya local"
      },
      "children": [
        {
          "id": "device_id",
          "type": "text",
          "label": {
            "en": "Device ID",
            "nl": "Apparaat-ID",
            "de": "Geräte-ID",
            "fr": "ID de l'appareil"
          },
          "value": ""
        },
        {
          "id": "local_key",
          "type": "text",
          "label": {
            "en": "Local Key",
            "nl": "Lokale sleutel",
            "de": "Lokaler Schlüssel",
            "fr": "Clé locale"
          },
          "value": ""
        },
        {
          "id": "ip",
          "type": "text",
          "label": {
            "en": "IP",
            "nl": "IP",
            "de": "IP",
            "fr": "IP"
          },
          "value": ""
        },
        {
          "id": "protocol_version",
          "type": "dropdown",
          "label": {
            "en": "Protocol",
            "nl": "Protocol",
            "de": "Protokoll",
            "fr": "Protocole"
          },
          "value": "auto",
          "values": [
            {
              "id": "auto",
              "label": {
                "en": "Auto (3.1-3.5)"
              }
            },
            {
              "id": "3.1",
              "label": {
                "en": "3.1"
              }
            },
            {
              "id": "3.3",
              "label": {
                "en": "3.3"
              }
            },
            {
              "id": "3.4",
              "label": {
                "en": "3.4"
              }
            },
            {
              "id": "3.5",
              "label": {
                "en": "3.5"
              }
            }
          ]
        },
        {
          "id": "command_gap_ms",
          "type": "number",
          "label": {
            "en": "Command Gap (ms)",
            "fr": "Écart entre commandes (ms)",
            "nl": "Opdracht-interval (ms)",
            "de": "Befehlsabstand (ms)"
          },
          "value": 100,
          "min": 0,
          "max": 10000,
          "units": {
            "en": "ms"
          },
          "hint": {
            "en": "Minimum gap between two LAN commands. Helps firmware that silently drops rapid SETs (protocol 3.4/3.5).",
            "fr": "Délai minimum entre deux commandes LAN. Évite les SET perdus sur protocole 3.4/3.5."
          }
        },
        {
          "id": "offline_grace_seconds",
          "type": "number",
          "label": {
            "en": "Offline Grace (seconds)",
            "fr": "Délai hors-ligne (s)",
            "nl": "Offline-grace (s)",
            "de": "Offline-Karenz (s)"
          },
          "value": 60,
          "min": 0,
          "max": 600,
          "units": {
            "en": "s"
          },
          "hint": {
            "en": "Delay before marking unavailable / firing disconnect flows after a brief TCP drop (pet feeders, dehumidifiers).",
            "fr": "Délai avant indisponible / flux déconnecté après une brève coupure TCP (pet feeders, déshumidificateurs)."
          }
        },
        {
          "id": "color_temp_reversed",
          "type": "checkbox",
          "value": false,
          "label": {
            "en": "Colour temperature reversed",
            "fr": "Température de couleur inversée",
            "nl": "Kleurtemperatuur omgekeerd",
            "de": "Farbtemperatur umgekehrt",
            "es": "Temperatura de color invertida"
          },
          "hint": {
            "en": "Only tick if warm and cold white are swapped on this bulb (rare firmware where 0 = cold).",
            "fr": "Cochez seulement si blanc chaud et blanc froid sont inversés sur cette ampoule (firmware rare où 0 = froid).",
            "nl": "Alleen aanvinken als warm- en koudwit verwisseld zijn.",
            "de": "Nur aktivieren, wenn Warm- und Kaltweiß vertauscht sind.",
            "es": "Marcar solo si el blanco cálido y frío están invertidos."
          }
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Adaptive lighting",
        "fr": "Éclairage adaptatif",
        "de": "Adaptive Beleuchtung",
        "nl": "Adaptieve verlichting"
      },
      "children": [
        {
          "id": "adaptive_lighting",
          "type": "checkbox",
          "value": true,
          "label": {
            "en": "Follow the sun (colour temperature)",
            "fr": "Suivre le soleil (température de couleur)",
            "de": "Dem Sonnenlauf folgen (Farbtemperatur)",
            "nl": "De zon volgen (kleurtemperatuur)"
          },
          "hint": {
            "en": "On by default. Nothing changes until the light is next switched on; a manual change pauses it for 60 min. Untick to disable for this light (global switch: app settings).",
            "fr": "Actif par défaut. Rien ne change avant le prochain allumage ; un réglage manuel le met en pause 60 min. Décochez pour désactiver sur cette lampe (interrupteur global : réglages de l'app)."
          }
        },
        {
          "id": "adaptive_brightness",
          "type": "checkbox",
          "value": false,
          "label": {
            "en": "Also adapt brightness",
            "fr": "Adapter aussi la luminosité",
            "de": "Auch die Helligkeit anpassen",
            "nl": "Ook de helderheid aanpassen"
          },
          "hint": {
            "en": "Off by default. Dimmer-only lights only adapt when this is on.",
            "fr": "Désactivé par défaut. Les lampes sans température de couleur ne s'adaptent que si cette option est active."
          }
        }
      ]
    },
    {
      "$extends": [
        "localtuya_advanced"
      ]
    }
  ],
  "images": {
    "small": "/drivers/wifi_light/assets/images/small.png",
    "large": "/drivers/wifi_light/assets/images/large.png"
  },
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "maintenanceActions": [
    {
      "id": "ota_check",
      "title": {
        "en": "Check Zigbee OTA Update",
        "fr": "Vérifier Mà J OTA",
        "nl": "Controleer op OTA-updates"
      }
    },
    {
      "id": "tuya_revive",
      "title": {
        "en": "Tuya Revive (device recovery)",
        "fr": "Tuya Revive (récupération appareil)",
        "nl": "Tuya Revive (apparaatherstel)",
        "de": "Tuya Revive (Gerätewiederherstellung)"
      }
    },
    {
      "id": "generate_issue_report",
      "title": {
        "en": "Generate support report (GitHub issue)",
        "fr": "Générer rapport de support (issue GitHub)",
        "nl": "Supportrapport genereren (GitHub issue)",
        "de": "Supportbericht erstellen (GitHub Issue)"
      }
    },
    {
      "id": "zigbee_rebind",
      "title": {
        "en": "Re-bind & reconfigure reporting",
        "fr": "Re-lier et reconfigurer les rapports",
        "nl": "Opnieuw binden en rapportage instellen",
        "de": "Neu binden und Reporting konfigurieren"
      }
    }
  ],
  "id": "wifi_light",
  "version": "1.0.0",
  "capabilitiesOptions": {
    "button.1": {
      "title": {
        "en": "Button 1",
        "fr": "Bouton 1"
      },
      "maintenanceAction": true,
      "getable": false,
      "setable": false
    }
  },
  "ui": {
    "quickAction": "onoff"
  },
  "discovery": "tuya_wifi"
}
