{
  "triggers": [
    {
      "id": "wifi_ir_remote_learning_started",
      "title": {
        "en": "IR learning started",
        "fr": "Apprentissage IR démarré",
        "nl": "IR-leren gestart",
        "de": "IR-Lernen gestartet"
      },
      "titleFormatted": {
        "en": "IR learning started ({name}) ({duration})",
        "fr": "Apprentissage IR démarré ({name}) ({duration})"
      },
      "tokens": [
        {
          "name": "name",
          "type": "string",
          "title": { "en": "Code name" }
        },
        {
          "name": "duration",
          "type": "number",
          "title": { "en": "Duration (s)" }
        }
      ],
      "args": [
        {
          "name": "device",
          "type": "device",
          "filter": "driver_id=wifi_ir_remote"
        }
      ]
    },
    {
      "id": "wifi_ir_remote_code_learned",
      "title": {
        "en": "IR code learned",
        "fr": "Code IR appris",
        "nl": "IR-code geleerd",
        "de": "IR-Code gelernt"
      },
      "titleFormatted": {
        "en": "IR code learned ({name}) ({format})",
        "fr": "Code IR appris ({name}) ({format})"
      },
      "tokens": [
        {
          "name": "name",
          "type": "string",
          "title": { "en": "Code name" }
        },
        {
          "name": "format",
          "type": "string",
          "title": { "en": "Format" }
        }
      ],
      "args": [
        {
          "name": "device",
          "type": "device",
          "filter": "driver_id=wifi_ir_remote"
        }
      ]
    },
    {
      "id": "wifi_ir_remote_learn_confirm_needed",
      "title": {
        "en": "IR learn needs confirm (press again)",
        "fr": "Confirmer l'apprentissage IR (rappuyer)"
      },
      "titleFormatted": {
        "en": "IR learn needs confirm ({name})",
        "fr": "Confirmer apprentissage ({name})"
      },
      "tokens": [
        {
          "name": "name",
          "type": "string",
          "title": { "en": "Code name" }
        }
      ],
      "args": [
        {
          "name": "device",
          "type": "device",
          "filter": "driver_id=wifi_ir_remote"
        }
      ]
    }
  ],
  "conditions": [],
  "actions": [
    {
      "id": "wifi_ir_remote_start_learn",
      "title": {
        "en": "Start IR learn",
        "fr": "Démarrer apprentissage IR"
      },
      "args": [
        {
          "name": "device",
          "type": "device",
          "filter": "driver_id=wifi_ir_remote"
        },
        {
          "name": "name",
          "type": "text",
          "placeholder": { "en": "power" }
        },
        {
          "name": "duration",
          "type": "number",
          "placeholder": { "en": "30" },
          "min": 5,
          "max": 120
        }
      ]
    },
    {
      "id": "wifi_ir_remote_send_learned",
      "title": {
        "en": "Send learned IR code",
        "fr": "Envoyer code IR appris"
      },
      "args": [
        {
          "name": "device",
          "type": "device",
          "filter": "driver_id=wifi_ir_remote"
        },
        {
          "name": "name",
          "type": "text",
          "placeholder": { "en": "power" }
        }
      ]
    },
    {
      "id": "wifi_ir_remote_send_raw",
      "title": {
        "en": "Send raw / pasted IR code",
        "fr": "Envoyer code IR brut / collé"
      },
      "args": [
        {
          "name": "device",
          "type": "device",
          "filter": "driver_id=wifi_ir_remote"
        },
        {
          "name": "code",
          "type": "text",
          "placeholder": { "en": "Pronto / HEX / Broadlink / opaque" }
        },
        {
          "type": "dropdown",
          "name": "format",
          "values": [
            { "id": "auto", "label": { "en": "Auto" } },
            { "id": "tuya_opaque", "label": { "en": "Tuya opaque" } },
            { "id": "pronto", "label": { "en": "Pronto Hex" } },
            { "id": "broadlink", "label": { "en": "Broadlink" } },
            { "id": "hex", "label": { "en": "HEX timings" } },
            { "id": "globalcache", "label": { "en": "Global Caché" } }
          ]
        }
      ]
    }
  ]
}
