{
  "triggers": [
    {
      "id": "wifi_ir_remote_learning_started",
      "title": {
        "en": "IR learning started",
        "fr": "Apprentissage IR démarré",
        "nl": "IR-leren gestart",
        "de": "IR-Lernen gestartet"
      },
      "tokens": [
        {
          "name": "name",
          "type": "string",
          "title": {
            "en": "Code name"
          }
        },
        {
          "name": "timeout_s",
          "type": "number",
          "title": {
            "en": "Timeout seconds"
          }
        }
      ],
      "args": [
        {
          "name": "device",
          "type": "device",
          "filter": "driver_id=wifi_ir_remote"
        }
      ],
      "titleFormatted": {
        "en": "IR learning started ({timeout_s})",
        "fr": "Apprentissage IR démarré ({timeout_s})",
        "nl": "IR-leren gestart ({timeout_s})",
        "de": "IR-Lernen gestartet ({timeout_s})"
      }
    },
    {
      "id": "wifi_ir_remote_code_learned",
      "title": {
        "en": "IR code learned",
        "fr": "Code IR appris",
        "nl": "IR-code geleerd",
        "de": "IR-Code gelernt"
      },
      "tokens": [
        {
          "name": "name",
          "type": "string",
          "title": {
            "en": "Code name"
          }
        },
        {
          "name": "format",
          "type": "string",
          "title": {
            "en": "Format"
          }
        }
      ],
      "args": [
        {
          "name": "device",
          "type": "device",
          "filter": "driver_id=wifi_ir_remote"
        }
      ],
      "titleFormatted": {
        "en": "IR code learned ({format})",
        "fr": "Code IR appris ({format})",
        "nl": "IR-code geleerd ({format})",
        "de": "IR-Code gelernt ({format})"
      }
    },
    {
      "id": "wifi_ir_remote_learn_confirm_needed",
      "title": {
        "en": "IR learn needs confirm — press again",
        "fr": "Confirmer l'apprentissage IR — rappuyer"
      },
      "tokens": [
        {
          "name": "name",
          "type": "string",
          "title": {
            "en": "Code name"
          }
        }
      ],
      "args": [
        {
          "name": "device",
          "type": "device",
          "filter": "driver_id=wifi_ir_remote"
        }
      ],
      "titleFormatted": {
        "en": "IR learn needs confirm — press again",
        "fr": "Confirmer l'apprentissage IR — rappuyer"
      }
    }
  ],
  "conditions": [],
  "actions": [
    {
      "id": "wifi_ir_remote_start_learn",
      "title": {
        "en": "Start IR learn",
        "fr": "Démarrer apprentissage IR"
      },
      "args": [
        {
          "name": "device",
          "type": "device",
          "filter": "driver_id=wifi_ir_remote"
        },
        {
          "name": "name",
          "type": "text",
          "placeholder": {
            "en": "power"
          }
        },
        {
          "name": "timeout_s",
          "type": "number",
          "placeholder": {
            "en": "30"
          },
          "min": 5,
          "max": 120
        }
      ]
    },
    {
      "id": "wifi_ir_remote_send_learned",
      "title": {
        "en": "Send learned IR code",
        "fr": "Envoyer code IR appris"
      },
      "args": [
        {
          "name": "device",
          "type": "device",
          "filter": "driver_id=wifi_ir_remote"
        },
        {
          "name": "name",
          "type": "text",
          "placeholder": {
            "en": "power"
          }
        }
      ]
    },
    {
      "id": "wifi_ir_remote_send_raw",
      "title": {
        "en": "Send raw / pasted IR code",
        "fr": "Envoyer code IR brut / collé"
      },
      "args": [
        {
          "name": "device",
          "type": "device",
          "filter": "driver_id=wifi_ir_remote"
        },
        {
          "name": "code",
          "type": "text",
          "placeholder": {
            "en": "Pronto / HEX / Broadlink / opaque"
          }
        },
        {
          "type": "dropdown",
          "name": "format",
          "values": [
            {
              "id": "auto",
              "title": {
                "en": "Auto"
              }
            },
            {
              "id": "tuya_opaque",
              "title": {
                "en": "Tuya opaque"
              }
            },
            {
              "id": "pronto",
              "title": {
                "en": "Pronto Hex"
              }
            },
            {
              "id": "broadlink",
              "title": {
                "en": "Broadlink"
              }
            },
            {
              "id": "hex",
              "title": {
                "en": "HEX timings"
              }
            },
            {
              "id": "globalcache",
              "title": {
                "en": "Global Caché"
              }
            }
          ]
        }
      ]
    }
  ]
}
