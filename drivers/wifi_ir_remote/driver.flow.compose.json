{
  "triggers": [
    {
      "id": "wifi_ir_remote_learning_started",
      "title": {
        "en": "IR learning started",
        "fr": "Apprentissage IR démarré",
        "nl": "IR-leren gestart",
        "de": "IR-Lernen gestartet"
      },
      "tokens": [
        {
          "name": "name",
          "type": "string",
          "title": {
            "en": "Code name",
            "fr": "Nom du code"
          }
        },
        {
          "name": "timeout_s",
          "type": "number",
          "title": {
            "en": "Timeout seconds",
            "fr": "Délai (secondes)"
          }
        }
      ],
      "args": [
        {
          "name": "device",
          "type": "device",
          "filter": "driver_id=wifi_ir_remote"
        }
      ],
      "titleFormatted": {
        "en": "IR learning started ([[device]])",
        "fr": "Apprentissage IR démarré ([[device]])"
      }
    },
    {
      "id": "wifi_ir_remote_code_learned",
      "title": {
        "en": "IR code learned",
        "fr": "Code IR appris",
        "nl": "IR-code geleerd",
        "de": "IR-Code gelernt"
      },
      "tokens": [
        {
          "name": "name",
          "type": "string",
          "title": {
            "en": "Code name",
            "fr": "Nom du code"
          }
        },
        {
          "name": "format",
          "type": "string",
          "title": {
            "en": "Format"
          }
        }
      ],
      "args": [
        {
          "name": "device",
          "type": "device",
          "filter": "driver_id=wifi_ir_remote"
        }
      ],
      "titleFormatted": {
        "en": "IR code learned ([[device]])",
        "fr": "Code IR appris ([[device]])"
      }
    },
    {
      "id": "wifi_ir_remote_learn_confirm_needed",
      "title": {
        "en": "IR learn needs confirm — press again",
        "fr": "Confirmer l'apprentissage IR — rappuyer"
      },
      "tokens": [
        {
          "name": "name",
          "type": "string",
          "title": {
            "en": "Code name",
            "fr": "Nom du code"
          }
        }
      ],
      "args": [
        {
          "name": "device",
          "type": "device",
          "filter": "driver_id=wifi_ir_remote"
        }
      ],
      "titleFormatted": {
        "en": "IR learn needs confirm — press again ([[device]])",
        "fr": "Confirmer l'apprentissage IR — rappuyer ([[device]])"
      }
    }
  ],
  "conditions": [],
  "actions": [
    {
      "id": "wifi_ir_remote_start_learn",
      "title": {
        "en": "Start IR learn",
        "fr": "Démarrer apprentissage IR"
      },
      "args": [
        {
          "name": "device",
          "type": "device",
          "filter": "driver_id=wifi_ir_remote"
        },
        {
          "name": "name",
          "type": "text",
          "placeholder": {
            "en": "power"
          }
        },
        {
          "name": "timeout_s",
          "type": "number",
          "placeholder": {
            "en": "30"
          },
          "min": 5,
          "max": 120
        }
      ],
      "titleFormatted": {
        "en": "Start IR learn [[name]] [[timeout_s]] ([[device]])",
        "fr": "Démarrer apprentissage IR [[name]] [[timeout_s]] ([[device]])"
      }
    },
    {
      "id": "wifi_ir_remote_send_learned",
      "title": {
        "en": "Send learned IR code",
        "fr": "Envoyer code IR appris"
      },
      "args": [
        {
          "name": "device",
          "type": "device",
          "filter": "driver_id=wifi_ir_remote"
        },
        {
          "name": "name",
          "type": "text",
          "placeholder": {
            "en": "power"
          }
        }
      ],
      "titleFormatted": {
        "en": "Send learned IR code [[name]] ([[device]])",
        "fr": "Envoyer code IR appris [[name]] ([[device]])"
      }
    },
    {
      "id": "wifi_ir_remote_send_raw",
      "title": {
        "en": "Send raw / pasted IR code",
        "fr": "Envoyer code IR brut / collé"
      },
      "args": [
        {
          "name": "device",
          "type": "device",
          "filter": "driver_id=wifi_ir_remote"
        },
        {
          "name": "code",
          "type": "text",
          "placeholder": {
            "en": "Pronto / HEX / Broadlink / opaque"
          }
        },
        {
          "type": "dropdown",
          "name": "format",
          "values": [
            {
              "id": "auto",
              "title": {
                "en": "Auto"
              },
              "label": {
                "en": "Auto"
              }
            },
            {
              "id": "tuya_opaque",
              "title": {
                "en": "Tuya opaque"
              },
              "label": {
                "en": "Tuya opaque"
              }
            },
            {
              "id": "pronto",
              "title": {
                "en": "Pronto Hex"
              },
              "label": {
                "en": "Pronto Hex"
              }
            },
            {
              "id": "broadlink",
              "title": {
                "en": "Broadlink"
              },
              "label": {
                "en": "Broadlink"
              }
            },
            {
              "id": "hex",
              "title": {
                "en": "HEX timings"
              },
              "label": {
                "en": "HEX timings",
                "fr": "Timings HEX"
              }
            },
            {
              "id": "globalcache",
              "title": {
                "en": "Global Caché"
              },
              "label": {
                "en": "Global Caché"
              }
            }
          ],
          "title": {
            "en": "Format",
            "fr": "Format"
          }
        }
      ],
      "titleFormatted": {
        "en": "Send raw / pasted IR code [[code]] [[format]] ([[device]])",
        "fr": "Envoyer code IR brut / collé [[code]] [[format]] ([[device]])"
      }
    }
  ]
}
