  "_meta": {
    "id": "marketing-model-alias-registry",
    "version": 1,
    "generated": "2026-08-16",
    "purpose": "Separate marketing / Zigbee2MQTT model names from the real Zigbee identity so enrichment never writes an alias into driver.compose.json productId.",
    "doctrine": "The pairing key is the sacred couple (manufacturerName, modelId) exactly as the device reports it. A vendor model name such as ZG-204ZM is a catalogue label: the hardware reports _TZE200_tyffvoij / TS0601. Writing the label as a productId can never match, and it widens the cartesian claim surface of the driver it sits in.",
    "relationship": "N:N:N - one manufacturerName has many productIds, one (mfr,pid) couple maps to several marketing names, and one marketing name covers several couples.",
    "evidence": [
      "data/z2m_cache.json",
      "data/zg204_investigation.json"
    ],
    "consumers": [
      "tools/ci/battery-button-intelligence-gate.js (rule F1)"
    ]
  },
