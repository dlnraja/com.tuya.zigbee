#!/usr/bin/env bash
# .githooks/pre-push
# ═══════════════════════════════════════════════════════════════════════════
# Homey App Pre-Push Gate — blocks push if mandatory checks fail
# More thorough than pre-commit (runs dual-layer gate + full validation)
# ═══════════════════════════════════════════════════════════════════════════

set -e

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; RESET='\033[0m'

echo ""
echo -e "${CYAN}╔══════════════════════════════════════════════════════════════╗${RESET}"
echo -e "${CYAN}║     HOMEY APP PRE-PUSH GATE (Full Validation)               ║${RESET}"
echo -e "${CYAN}╚══════════════════════════════════════════════════════════════╝${RESET}"

ROOT="$(git rev-parse --show-toplevel)"
# P3025: loud failure (not silent) when node/node_modules are missing; picks Node >= 22; one auto npm ci failover
[ -f "$ROOT/.githooks/lib-deps-check.sh" ] && . "$ROOT/.githooks/lib-deps-check.sh"

# Full mandatory check (blocking)
echo -e "${CYAN}[1/2] Mandatory files check...${RESET}"
if ! node "$ROOT/scripts/validate/homey-mandatory-check.js"; then
  echo -e "${RED}❌ PUSH BLOCKED — Fix mandatory check errors first${RESET}"
  exit 1
fi

# Athom server requirements check (O17-O21)
echo -e "${CYAN}[2/3] Athom server requirements check...${RESET}"
if ! node "$ROOT/scripts/validate/validate-app-json.js"; then
  echo -e "${RED}❌ PUSH BLOCKED — Fix Athom server requirement errors first${RESET}"
  exit 1
fi

echo -e "${CYAN}[3/3] Publish payload size gate...${RESET}"
if ! node "$ROOT/scripts/ci/publish-size-gate.cjs"; then
  echo -e "${RED}❌ PUSH BLOCKED — Publish payload too large for safe Homey processing${RESET}"
  exit 1
fi

# Duplicate-couple gate (every port: master/stable/bastien) — new collisions need an exact-pair driver or a reviewed baseline entry
if [ -f "$ROOT/.github/scripts/fp-collision-check.js" ]; then
  echo -e "${CYAN}[+] Duplicate mfr+pid couple gate...${RESET}"
  if ! node "$ROOT/.github/scripts/fp-collision-check.js" --baseline "$ROOT/.github/fingerprint-collision-baseline.json" >/tmp/fp-collision.log 2>&1; then
    grep "NEW COLLISION" /tmp/fp-collision.log | head -20
    echo -e "${RED}❌ PUSH BLOCKED — new duplicate couple(s): add an exact-pair driver or a reviewed baseline entry (no removal)${RESET}"
    exit 1
  fi
fi

# P3025: hook/CI parity — the same shared rules-gates core profile CI runs (.github/actions/rules-gates).
# Fast (~2 s); skip only for an emergency with HOOKS_SKIP_RULES_GATES=1 (CI still runs it).
if [ -f "$ROOT/scripts/ci/rules-gates.js" ] && [ "${HOOKS_SKIP_RULES_GATES:-0}" != "1" ]; then
  echo -e "${CYAN}[+] Shared rules-gates (core profile, same as CI)...${RESET}"
  if ! (cd "$ROOT" && "${NODE_BIN:-node}" scripts/ci/rules-gates.js --profile=core) >/tmp/p3025-rules-gates.log 2>&1; then
    tail -25 /tmp/p3025-rules-gates.log
    echo -e "${RED}❌ PUSH BLOCKED — rules-gates core failed (same gate as CI). Run: node scripts/ci/rules-gates.js --profile=core${RESET}"
    exit 1
  fi
fi

# P3025: same manifest/data/lint gates as ci-self-check (changed-files lint = fast).
if [ "${HOOKS_SKIP_DATA_GATES:-0}" != "1" ]; then
  for _g in "scripts/ci/appjson-compose-drift-gate.js" "scripts/data/build-dp-shards.js --check" "scripts/ci/lint-ratchet.js --changed"; do
    _f=${_g%% *}
    [ -f "$ROOT/$_f" ] || continue
    if ! (cd "$ROOT" && "${NODE_BIN:-node}" $_g) >/tmp/p3025-data-gate.log 2>&1; then
      tail -25 /tmp/p3025-data-gate.log
      echo -e "${RED}❌ PUSH BLOCKED — gate failed: node $_g (same gate as CI ci-self-check)${RESET}"
      exit 1
    fi
  done
fi

echo ""
echo -e "${GREEN}╔══════════════════════════════════════════════════════════════╗${RESET}"
echo -e "${GREEN}║  ✅ PRE-PUSH GATE PASSED — Push allowed                     ║${RESET}"
echo -e "${GREEN}╚══════════════════════════════════════════════════════════════╝${RESET}"
exit 0
